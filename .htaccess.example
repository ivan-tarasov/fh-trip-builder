# Template for the web server's .htaccess — copy it into place on deploy:
#
#     cp .htaccess.example .htaccess
#
# The live .htaccess is deliberately NOT tracked (see .gitignore). Hosting
# panels such as cPanel own that file and rewrite it — for example the
# "# php -- BEGIN cPanel-generated handler" block that pins the PHP version.
# A tracked copy would collide with the server on every deploy, and pulling
# over it would silently drop that block, leaving the app on the wrong PHP.
#
# So: copy this once, then let the server keep its own copy. If you re-copy it
# later, re-add any panel-generated blocks afterwards.
#
# Front-controller routing: send every request that doesn't map to a real file
# or directory through index.php, so clean URLs like /search/ and
# /api/airports/autofill reach the router (index.php reads the path from
# REQUEST_URI). Static assets still serve directly via the -f/-d checks.
# Apache only; nginx does this in its vhost with try_files ... /index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# The fonts are served from this app rather than from Google (see the #FONTS
# section of frontend/css/main.css). Two things they need from the server:
#
# The media type, because Apache only learned font/woff2 in 2.4.26 and an older
# host would serve them as application/octet-stream. Browsers still accept that
# when the stylesheet declares format("woff2"), but the correct type is what
# lets compression and caching rules match on it.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# And a long cache. A font file's contents never change -- a new version is a
# new filename -- so there is nothing to revalidate. `immutable` tells the
# browser not to even ask on a reload.
<IfModule mod_headers.c>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Already compressed: woff2 is Brotli-compressed internally, so running it
# through gzip again costs CPU and adds bytes.
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI "\.woff2$" no-gzip dont-vary
</IfModule>
