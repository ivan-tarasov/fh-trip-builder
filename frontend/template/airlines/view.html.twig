{% extends 'layout.html.twig' %}

{% block title %}Airlines we sell{% endblock %}

{% block description %}Every airline in our schedules, A to Z, with its hubs, its cheapest fares and how to contact it.{% endblock %}

{# Every airline, as a directory -- the fourth page built on the component the
   cities, countries and airports use. #}
{% block content %}
<main role="main" class="page-list">
    <div class="container">
        {% include 'partials/directory.html.twig' with {
            'title': 'Airlines we sell',
            'lead': 'Every airline in our schedules, with its hubs and the cheapest fares on each.',
            'placeholder': 'Start typing an airline, a country or a code',
            'label': 'Filter airlines',
            'groups': groups
        } only %}
    </div>
</main>
{% endblock %}
