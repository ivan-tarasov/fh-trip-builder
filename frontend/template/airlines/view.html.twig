    <div class="container">
        <div class="pt-5 pb-5 mx-auto">
            <h1 class="display-4">Airlines</h1>
            <p class="lead">Here you can see all added airlines.</p>
        </div>

        <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
            {% for airline in airlines %}
