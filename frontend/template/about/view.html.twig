{% extends 'layout.html.twig' %}

{% block title %}About{% endblock %}

{% block description %}What Trip Builder is and how it is built, taken straight from the repository README.{% endblock %}

{% block content %}
{% embed 'partials/article.html.twig' with {
    'title': 'About this project',
    'icon': 'fa-book',
    'lead': "Straight from the repository's README, so this page says exactly what the project says about itself.",
    'body_class': 'readme'
} %}
    {# Already-safe HTML: View\Readme escapes raw HTML in the source and drops
       unsafe link schemes, so escaping again here would print tags. #}
    {% block body %}{{ readme_html|raw }}{% endblock %}

    {% block note %}
        <p class="article__note">
            {% if updated_at %}Last updated {{ updated_at|date('j F Y') }}. {% endif %}
            <a href="{{ repo_url }}#readme" target="_blank" rel="noopener">
                Read it on GitHub<i class="fas fa-arrow-up-right-from-square ms-2"></i>
            </a>
            alongside the source.
        </p>
    {% endblock %}
{% endembed %}
{% endblock %}
