{# One labelled input, with its error in place of its hint when it has one.
   A field that failed keeps what was typed — retyping an address because one
   digit of a postcode was wrong is the fastest way to lose a booking. #}
<div class="field">
    <label class="field__label" for="{{ name }}">{{ label }}</label>
    <input class="field__input{{ errors[name] is defined ? ' is-invalid' : '' }}"
           id="{{ name }}"
           name="{{ name }}"
           type="{{ type|default('text') }}"
           value="{{ form[name]|default('') }}"
           {% if placeholder is defined %}placeholder="{{ placeholder }}"{% endif %}
           {% if autocomplete is defined %}autocomplete="{{ autocomplete }}"{% endif %}
           {# Mirrors the server's limit for this field, so the browser stops
              the typing rather than the INSERT stopping the booking. The
              server still checks: an attribute is a courtesy, not a guard. #}
           {% if max_lengths[name] is defined %}maxlength="{{ max_lengths[name] }}"{% endif %}
           {% if attrs is defined %}{{ attrs|raw }}{% endif %}
           {{ errors[name] is defined ? 'aria-invalid="true"' : '' }} />
    {% if errors[name] is defined %}
        <p class="field__error">{{ errors[name] }}</p>
    {% endif %}
</div>
