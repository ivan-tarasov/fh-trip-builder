{% import 'partials/money.html.twig' as money %}
{% extends 'layout.html.twig' %}

{% block title %}Booking confirmed{% endblock %}

{#
    The page after the money. Its job is to answer, without being asked: did it
    work, what did I buy, what was I charged, and what do I quote if I need to
    ring someone. The reference leads because it is the one thing worth writing
    down.
#}

{% block content %}
<main role="main" class="flex-shrink-0 mb-5">
    <div class="container checkout">

        <div class="done">
            <i class="fas fa-circle-check done__icon"></i>
            <h1 class="done__title">You&rsquo;re booked</h1>
            {# No email is sent, and this line used to say one was.

               There is no mailer in this project -- composer requires dotenv,
               console, twig and commonmark, and nothing else -- so "We sent the
               ticket to you@example.com" was a promise the app had no way to
               keep, and it sent people off to wait for it and then to look in a
               spam folder. See config/content/help/ticket-not-received.md,
               which had picked the claim up and repeated it.

               The address is still worth printing: it is what was typed, it is
               what is stored against the booking, and seeing it is how somebody
               notices they mistyped it. #}
            <p class="done__lead">
                Kept under <a href="/my/bookings">My bookings</a> in this browser, with
                <strong>{{ email }}</strong> as the contact address. Nothing is emailed
                &mdash; {{ config('app.name') }} issues no ticket &mdash; so the reference
                below is the part worth writing down.
            </p>

            <div class="done__reference">
                <span class="done__reference-label">Booking reference</span>
                <span class="done__reference-code">{{ booking.reference }}</span>
            </div>
        </div>

        <div class="done__panels">
            <section class="pane" aria-labelledby="itinerary-heading">
                <h2 class="pane__heading" id="itinerary-heading">Your flights</h2>

                {# The same view-model and the same partials the bookings list
                   uses, so the trip just paid for and the one come back to
                   later are drawn from one shape. What this replaced flattened
                   each leg to six strings and threw the rest away. #}
                {% for half in [
                    { 'label': 'Departing', 'direction': booking.outbound },
                    { 'label': 'Returning', 'direction': booking.return }
                ] %}
                    {% if half.direction %}
                        <p class="done__direction">{{ half.label }}</p>
                        {% include 'search/cards/itinerary-detail.html.twig' with { 'direction': half.direction } only %}
                    {% endif %}
                {% endfor %}
            </section>

            <section class="pane" aria-labelledby="receipt-heading">
                <h2 class="pane__heading" id="receipt-heading">Receipt</h2>

                <dl class="order__prices">
                    <div class="order__price-row">
                        <dt>{{ booking.passengers|length > 1 ? 'Passengers' : 'Passenger' }}</dt>
                        <dd>
                            {% for traveller in booking.passengers %}
                                {{ traveller.name }}{% if booking.passengers|length > 1 %} <span class="text-muted">({{ traveller.type|lower }})</span>{% endif %}{{ not loop.last ? '<br />'|raw : '' }}
                            {% else %}
                                {{ booking.passenger }}
                            {% endfor %}
                        </dd>
                    </div>
                    <div class="order__price-row">
                        <dt>Paid with</dt>
                        <dd>{{ booking.card_brand }} ending {{ booking.card_last4 }}</dd>
                    </div>
                    <div class="order__price-row order__price-row--total">
                        <dt>Charged</dt>
                        <dd>{{ money.plain(booking.price_total) }}</dd>
                    </div>
                </dl>

                <p class="done__demo">
                    No money moved — this is a demo booking.
                </p>

                <a class="checkout__pay checkout__pay--link" href="{{ bookings_url }}">
                    See all my bookings
                </a>
            </section>
        </div>
    </div>
</main>
{% endblock %}
