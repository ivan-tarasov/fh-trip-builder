{% extends 'layout.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{# The summary off the article's row, unchanged. It is the description,
   the card's line on the hub and the lead below -- one sentence in one place,
   because three copies of it are three chances for them to stop agreeing. #}
{% block description %}{{ article.summary }}{% endblock %}

{# Paired with `'hero': true` below: this tells the layout not to draw the
   breadcrumb strip, because the band draws the trail itself. #}
{% block hero %}yes{% endblock %}

{% block content %}
{% embed 'partials/article.html.twig' with {
    'title': article.title,
    'icon': article.icon,
    'lead': article.summary,
    'hero': true
} %}
    {# The prose, from the one template named after this slug.

       Derived rather than written out, unlike the block lists on the place and
       booking pages: there the paths are spelled so a template can be found by
       searching for where it is used, and here there is one line to find --
       this one. The slug reaching it has already been matched against the
       article index, so it is one of five words and not something off a URL. #}
    {% block body %}{% include 'help/articles/' ~ article.slug ~ '.html.twig' %}{% endblock %}

    {% block note %}{% include 'partials/article-verdict.html.twig' %}{% endblock %}

    {# The other four. An article has no data of its own to link out with, so
       its siblings are what it offers -- and they are what keep each of these
       reachable from somewhere other than the footer. #}
    {% block aside %}
        <aside class="article__aside" aria-labelledby="more-help-title">
            <h2 class="article__aside-title" id="more-help-title">More help</h2>
            <ul class="chips">
                {% for topic in more %}
                    <li>
                        <a class="chip chip--link" href="{{ topic.url }}">
                            <i class="fas {{ topic.icon }} chip__icon" aria-hidden="true"></i>
                            {{ topic.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </aside>
    {% endblock %}
{% endembed %}
{% endblock %}
