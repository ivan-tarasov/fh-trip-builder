{% extends 'layout.html.twig' %}

{% block title %}Help{% endblock %}

{% block description %}Baggage, refunds, tickets, passenger details and flying with children — what this site decides, what the fare decides, and what the airline decides.{% endblock %}

{% block content %}
<main role="main" class="help">
    <div class="container help__layout">
        <div class="help__article">
            <h1 class="help__title">
                <i class="fas fa-circle-question help__title-icon" aria-hidden="true"></i>
                Help
            </h1>
            <p class="help__lead">
                Five things people ask before they book and after. Most answers
                come down to the same split: the fare decides what a ticket
                allows, and the airline decides what happens at the airport.
            </p>

            {# A card each rather than a list of links: the summary is the half
               that tells somebody which of five pages they want, and a
               footer-style list of titles makes them open two to find out. #}
            <ul class="help-list">
                {% for article in articles %}
                    <li>
                        <a class="help-card" href="{{ article.url }}">
                            <span class="help-card__icon">
                                <i class="fas {{ article.icon }}" aria-hidden="true"></i>
                            </span>
                            <span class="help-card__text">
                                <span class="help-card__title">{{ article.title }}</span>
                                <span class="help-card__summary">{{ article.summary }}</span>
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</main>
{% endblock %}
