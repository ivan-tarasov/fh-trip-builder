{% extends 'layout.html.twig' %}

{% block title %}Help{% endblock %}

{% block description %}Searching, paying, baggage, refunds and travelling with children — what this site decides, what the fare decides, and what the airline decides.{% endblock %}

{# Paired with the band below: this tells the layout not to draw the breadcrumb
   strip, because the band draws the trail itself. #}
{% block hero %}yes{% endblock %}

{% block content %}
{# The hub does not embed partials/article.html.twig the way an article and a
   legal document do. That partial is one sheet of prose with an aside under
   it, and this page is a rail beside a stack of cards -- putting cards inside
   the sheet would draw cards on a card. What it borrows instead is the shell:
   `article article--hero` and `article__hero` are the band and the rise into
   it, so the hub arrives the same way its articles do, and ArticleHeroTest
   holds all three of us to that. #}
<main role="main" class="article article--hero">
    <div class="article__hero">
        <div class="container">
            {% include 'partials/breadcrumbs.html.twig' with {'on_dark': true, 'hide_current': true} %}
            <h1 class="article__title">Help</h1>
        </div>
    </div>

    <div class="container article__layout article__layout--hub">
        {# The rail. Anchors rather than links to pages of their own: there are
           three groups and nine articles, so a page each would be three pages
           holding two or three links, and the reader would pay a page load to
           find out. `aria-current` is written by the script that watches which
           card is on screen; without it the rail is still a working table of
           contents. #}
        <nav class="help-rail" aria-labelledby="help-rail-title">
            <h2 class="help-rail__title" id="help-rail-title">On this page</h2>
            <ul class="help-rail__list">
                {% for group in groups %}
                    <li>
                        <a class="help-rail__link js-help-rail-link" href="#{{ group.slug }}">{{ group.title }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <div class="help-groups">
            {% for group in groups %}
                {# `tabindex="-1"` so following a rail link moves focus here and
                   not just the scroll position: without it a keyboard reader
                   jumps the viewport and leaves the cursor at the top of the
                   page, and the next Tab goes back to the rail. #}
                <section class="help-group" id="{{ group.slug }}" tabindex="-1"
                         aria-labelledby="{{ group.slug }}-title">
                    <div class="help-group__head">
                        <span class="help-group__icon help-group__icon--{{ group.accent }}">
                            <i class="fas {{ group.icon }}" aria-hidden="true"></i>
                        </span>
                        <div class="help-group__heading">
                            <h2 class="help-group__title" id="{{ group.slug }}-title">{{ group.title }}</h2>
                            <p class="help-group__summary">{{ group.summary }}</p>
                        </div>
                    </div>

                    {# Titles and no summaries, which reverses what this page
                       used to do. The old hub gave each of five articles a
                       summary because there was nothing else to tell them
                       apart; the group and its sentence do that job now, and
                       nine summaries stacked in one column is a page nobody
                       reads to the bottom of. #}
                    <ul class="help-group__list">
                        {% for article in group.articles %}
                            <li class="help-group__item">
                                <a class="help-group__link" href="{{ article.url }}">
                                    <span class="help-group__label">{{ article.title }}</span>
                                    <i class="fas fa-chevron-right help-group__chevron" aria-hidden="true"></i>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </div>
    </div>
</main>
{% endblock %}
