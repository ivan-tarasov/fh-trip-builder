<div class="list-group-item list-group-item-action">
    <div class="row align-items-center">

        <div class="col">
            <i class="fa-solid fa-hashtag"></i>
            <i class="fa-solid fa-{{ rank }}"></i>
        </div>
        <div class="col-lg-2 text-end">
            {{ search.from_name }}
        </div>
        <div class="col text-center">
            <i class="fa fa-arrow-right-{{ search.triptype == 'roundtrip' ? 'arrow-left' : 'long' }}"></i>
        </div>
        <div class="col-lg-2">
            {{ search.to_name }}
        </div>
        <div class="col-lg-3">
            {{ search.depart|date('D, F j') }}{% if search.return %} – {{ search.return|date('D, F j') }}{% endif %}
            {% if search.class_label %}<span class="search-cabin">{{ search.class_label }}</span>{% endif %}
        </div>
        <div class="col-lg-2 text-end">
            {{ search.search_count|number_format }} searches
        </div>

        <div class="col-lg-2 mx-auto d-grid gap-2">
            <a href="/search/?hash={{ search.hash|url_encode }}" type="button" class="btn btn-outline-ink btn-sm">Search flights</a>
        </div>

    </div>
</div>
