{% extends 'layout.html.twig' %}

{% block title %}Find flights{% endblock %}

{% block content %}
<style>
    .bg-img {
        background-image: url("{{ bg_image_url }}");
        background-size: cover;
        background-position: center;
        position: relative; /* Make sure the container has a positioning context */
    }

    #nav-tab {
        padding-bottom: 1px;
    }

    #nav-tab,
    #nav-tab button {
        border: unset;
    }

    /* The emphasis used to run backwards: the unselected tab was solid black
       -- the highest-contrast thing in the hero -- while the selected one was
       near-white. The selected tab now carries the accent and the unselected
       recedes into translucent ink over the photograph. */
    #nav-tab .nav-link {
        background-color: rgba(16, 36, 63, .7);
        color: #fff;
    }

    #nav-tab .nav-link:hover {
        background-color: rgba(16, 36, 63, .85);
        color: #fff;
    }

    #nav-tab .active,
    #nav-tab .nav-link.active:hover {
        background-color: var(--brand-accent);
        color: #fff;
    }

    .container-between {
        padding-top: 3rem;
    }

    @media (min-width: 1200px) {
        .container-up {
            padding-bottom: 200px;
        }

        .container-between {
            padding-top: 0;
            position: relative;
            top: -185px;
            max-height: 200px;
            margin-top: 0;
        }
    }
</style>
<div class="bg-primary">
    <div class="container container-up mb-5">
        <div class="row py-2 mb-0 pe-lg-0 pt-lg-0 align-items-center rounded-4 shadow-lg bg-light bg-img">
            <div class="row align-items-center py-5">
                <div class="col-lg-7 text-center text-lg-start"></div>
                <div class="col-md-10 mx-auto col-lg-5">

                    {# The whole form lives in search/form.html.twig now. The hero used
                       to carry its own copy: a Round trip tab that shipped `disabled`, a
                       cabin select comparing 'economy' to itself so it always rendered
                       Economy, and the passenger partial included with no party so it
                       always said one adult. #}
                    {% include 'search/form.html.twig' with {
                        'variant': 'hero',
            'places': places,
                        'depart_date': today_date
                    } only %}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container container-between">
    <div class="row row-cols-1 row-cols-lg-3 align-items-stretch g-4">
        {% for poi in poi_cards %}
            {% include 'index/poi.html.twig' %}
        {% endfor %}
    </div>
</div>

<div class="container px-4 py-5" id="icon-grid">
    <h2 class="pb-2 mb-4 border-bottom">Top searches</h2>

    <div class="list-group">
        {% for search in top_searches %}
            {% include 'index/top-search.html.twig' with {'rank': loop.index} %}
        {% endfor %}
    </div>
</div>
{% endblock %}
