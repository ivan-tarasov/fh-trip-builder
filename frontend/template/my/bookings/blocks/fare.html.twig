{# What the ticket allows. The terms as they were sold, marked the same way
   checkout marked them, so what was agreed to and what is shown back read
   identically. Older bookings kept only the brand name. #}
<p class="fare__name">{{ booking.fare_brand }}</p>

{% if booking.fare_rules %}
    <ul class="fare__rules">
        {% for line in booking.fare_rules %}
            <li class="rules__item{{ line.allowed ? '' : ' rules__item--restricted' }}">
                <i class="fas {{ line.allowed ? 'fa-check' : 'fa-xmark' }} rules__icon"></i>
                {{ line.text }}
            </li>
        {% endfor %}
    </ul>
{% endif %}
