{% extends 'layout.html.twig' %}

{% block title %}Booking {{ booking.reference|default(booking.id) }}{% endblock %}

{# One booking on its own page. The card on the list has to stay scannable
   beside its siblings; here there is only one, so the itinerary is already
   open and the calendar file is worth offering. #}
{% set halves = [
    { 'label': 'Departing', 'icon': 'fa-plane-departure', 'direction': booking.outbound },
    { 'label': 'Returning', 'icon': 'fa-plane-arrival', 'direction': booking.return }
] %}

{# The page as a list of blocks.

   It used to be one card holding everything, which meant the receipt lived in
   the footer of the flights and there was nowhere to put a third thing. Each
   block is now its own file behind its own heading, and adding one is a file
   plus a line here -- baggage, seats, check-in, whatever comes next.

   `when` keeps a block that has nothing to say from drawing an empty shell.
   The template path is written out rather than built from the key, so a block
   can be found by searching for where it is used. #}
{% set blocks = [
    {
        'key': 'flights',
        'title': 'Flights',
        'icon': 'fa-plane-up',
        'template': 'my/bookings/blocks/flights.html.twig',
        'when': booking.outbound or booking.return
    },
    {
        'key': 'receipt',
        'title': 'Receipt',
        'icon': 'fa-receipt',
        'template': 'my/bookings/blocks/receipt.html.twig',
        'when': true
    }
] %}

{% block content %}
<main role="main" class="flex-shrink-0 mb-5">
    <div class="container bookings">

        {# Said first and said plainly. A pill in the corner of a header is not
           enough for the one fact that changes what every other fact on this
           page means. #}
        {% if booking.is_cancelled %}
            <div class="booking-void booking-void--page" role="status">
                <i class="fas fa-ban" aria-hidden="true"></i>
                <span>
                    <strong>This booking was cancelled.</strong>
                    The flights below are no longer held and the reference will not check in.
                </span>
            </div>
        {% endif %}

        {# Who this belongs to and what to quote down a phone. It leads the page
           because it is what somebody opens the page holding: a reference, a
           name, and the date they paid. #}
        <header class="booking-head{{ booking.is_cancelled ? ' booking-head--cancelled' : '' }}">
            <div class="booking-head__identity">
                {% if booking.reference %}
                    <p class="booking-head__label">Booking reference</p>
                    <div class="booking-head__code-row">
                        <h1 class="booking-head__code">{{ booking.reference }}</h1>
                        <button type="button" class="icon-btn js-copy"
                                data-copy-text="{{ booking.reference }}"
                                aria-label="Copy booking reference {{ booking.reference }}"
                                data-toggle="tooltip" data-placement="top" title="Copy reference">
                            <i class="fa-regular fa-copy icon-idle"></i>
                            <i class="fa-solid fa-check icon-done"></i>
                        </button>
                    </div>
                {% else %}
                    {# Written before checkout issued references. The name leads
                       instead of an empty box or a made-up code. #}
                    <h1 class="booking-head__code booking-head__code--none">Your booking</h1>
                {% endif %}

                {# The lead traveller, then how many of them and when it was
                   bought. `passenger_summary` is not used here: on a solo
                   booking it is the lead's name again, which put the same name
                   on two consecutive lines. #}
                <p class="booking-head__who">{{ booking.passenger }}</p>
                <p class="booking-head__meta">
                    {%- set party = booking.passengers|length -%}
                    {%- if party > 1 %}{{ party }} travellers{% if booking.created %} &middot; {% endif %}{% endif -%}
                    {%- if booking.created %}booked {{ booking.created|date('j M Y') }}{% endif -%}
                </p>
            </div>

            <div class="booking-head__state">
                <span class="booking-status booking-status--{{ booking.is_cancelled ? 'cancelled' : (booking.is_past ? 'flown' : 'confirmed') }}">
                    {{ booking.is_cancelled ? booking.status_label : (booking.is_past ? 'Flown' : booking.status_label) }}
                </span>
                {% if booking.departs_in and not booking.is_cancelled %}
                    <span class="booking-when">
                        <i class="fas fa-clock" aria-hidden="true"></i> {{ booking.departs_in }}
                    </span>
                {% endif %}
            </div>
        </header>

        {# What you can do with this booking. Kept as one row so the next thing
           added here sits beside these rather than somewhere else on the page. #}
        <div class="booking-actions mb-4">
            {# Not offered on a cancelled booking: the file would put flights
               nobody is on into somebody's calendar. Flying the route again is
               still worth offering -- it is the obvious next thing after a
               trip falls through. #}
            {% if not booking.is_cancelled %}
                <a class="btn btn-sm btn-outline-secondary" href="/my/bookings/{{ booking.id }}/calendar">
                    <i class="fas fa-calendar-plus pe-1"></i> Add to calendar
                </a>
            {% endif %}
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-bs-toggle="modal" data-bs-target="#rebook-{{ booking.id }}">
                <i class="fas fa-rotate-right pe-1"></i> Fly this route again
            </button>
        </div>

        {% for block in blocks %}
            {% if block.when %}
                <section class="bkblock" aria-labelledby="bkblock-{{ block.key }}">
                    <h2 class="bkblock__title" id="bkblock-{{ block.key }}">
                        <i class="fas {{ block.icon }} bkblock__icon" aria-hidden="true"></i>
                        {{ block.title }}
                    </h2>
                    <div class="bkblock__body">
                        {% include block.template with { 'booking': booking, 'halves': halves } only %}
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </div>
</main>

{% include 'my/bookings/rebook-modal.html.twig' with { 'booking': booking } only %}
{% endblock %}
