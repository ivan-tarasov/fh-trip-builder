{% extends 'layout.html.twig' %}

{% block title %}{{ tab == 'cancelled' ? 'Cancelled bookings' : 'My bookings' }}{% endblock %}

{# Two addresses, drawn as a tab strip.

   Cancelled trips are off on their own page rather than filed under the rest.
   Mixed in, every glance at the list meant re-reading the status of everything
   on it, and the one question the page exists to answer -- is this trip still
   on? -- was the slowest one to get to.

   Real links, not a JS tab widget: this app renders on the server, and a
   cancelled booking is exactly the kind of thing somebody wants to send to an
   airline. Back and bookmark both work because there is nothing to work around. #}
{% set tabs = [
    { 'key': 'active', 'title': 'Active', 'href': '/my/bookings', 'count': active_count },
    { 'key': 'cancelled', 'title': 'Cancelled', 'href': '/my/bookings/cancelled', 'count': cancelled_count }
] %}

{% block content %}
<main role="main" class="flex-shrink-0 mb-5">
    <div class="container bookings">
        <div class="py-5 mx-auto">
            <h1 class="display-4">My bookings</h1>
            <p class="lead">Every trip booked in this browser, with its reference and the full itinerary.</p>
        </div>

        <nav class="bookings-tabs" aria-label="Booking status">
            {% for item in tabs %}
                <a href="{{ item.href }}"
                   class="bookings-tabs__tab{{ item.key == tab ? ' is-current' : '' }}"
                   {{ item.key == tab ? 'aria-current="page"' : '' }}>
                    {{ item.title }}
                    <span class="bookings-tabs__count">{{ item.count }}</span>
                </a>
            {% endfor %}
        </nav>

        {# Cancelling changes a card in place rather than moving it, which gives
           a screen reader no cue on its own. #}
        <p class="visually-hidden js-bookings-live" role="status" aria-live="polite"></p>

        {% for group in groups %}
            {% if group.bookings %}
                <section aria-labelledby="bookings-{{ group.key }}">
                    <div class="d-flex align-items-baseline gap-2 mb-3">
                        <h2 class="h4 mb-0" id="bookings-{{ group.key }}">{{ group.title }}</h2>
                        <span class="badge text-bg-light border text-secondary fw-normal">{{ group.bookings|length }}</span>
                    </div>

                    {% for booking in group.bookings %}
                        {% include 'my/bookings/card.html.twig' with { 'booking': booking } only %}
                    {% endfor %}
                </section>
            {% endif %}
        {% endfor %}

        {% if not has_rows %}
            {% include 'my/bookings/empty.html.twig' with { 'tab': tab } only %}
        {% endif %}
    </div>
</main>
{% endblock %}
