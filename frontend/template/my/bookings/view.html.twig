{% extends 'layout.html.twig' %}

{% set titles = { 'active': 'My bookings', 'past': 'Past bookings', 'cancelled': 'Cancelled bookings' } %}

{% block title %}{{ titles[tab] }}{% endblock %}

{# Three addresses, drawn as a tab strip.

   Flown and cancelled trips are off on their own pages rather than filed under
   the ones still to come. Mixed in, every glance at the list meant re-reading
   the status of everything on it, and the one question the page exists to
   answer -- what is coming up? -- was the slowest one to get to.

   Real links, not a JS tab widget: this app renders on the server, and a
   cancelled booking is exactly the kind of thing somebody wants to send to an
   airline. Back and bookmark both work because there is nothing to work around. #}
{% set tabs = [
    { 'key': 'active', 'title': 'Active', 'href': '/my/bookings' },
    { 'key': 'past', 'title': 'Past', 'href': '/my/bookings/past' },
    { 'key': 'cancelled', 'title': 'Cancelled', 'href': '/my/bookings/cancelled' }
] %}

{% block content %}
<main role="main" class="flex-shrink-0 mb-5">
    <div class="container bookings">
        {% include 'partials/page-head.html.twig' with {
            'title': 'My bookings',
            'lead': 'Every trip booked in this browser, with its reference and the full itinerary.'
        } only %}

        <nav class="bookings-tabs" aria-label="Booking status">
            {% for item in tabs %}
                {# The attribute is written by the template rather than
                   printed from an expression: autoescaping is on, and a quoted
                   attribute built inside {{ }} is one Twig version away from
                   arriving as &quot;. #}
                <a href="{{ item.href }}"
                   class="bookings-tabs__tab{{ item.key == tab ? ' is-current' : '' }}"
                   {% if item.key == tab %}aria-current="page"{% endif %}>
                    {{ item.title }}
                    <span class="bookings-tabs__count">{{ counts[item.key] }}</span>
                </a>
            {% endfor %}
        </nav>

        {# A cancelled card leaves this page for the cancelled one. Something
           disappearing is not an event a screen reader announces on its own. #}
        <p class="visually-hidden js-bookings-live" role="status" aria-live="polite"></p>

        {% for group in groups %}
            {% if group.bookings %}
                <section aria-labelledby="bookings-{{ group.key }}">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h2 class="h4 mb-0" id="bookings-{{ group.key }}">{{ group.title }}</h2>
                        <span class="bookings-count">{{ group.bookings|length }}</span>
                    </div>

                    {% for booking in group.bookings %}
                        {% include 'my/bookings/card.html.twig' with { 'booking': booking } only %}
                    {% endfor %}
                </section>
            {% endif %}
        {% endfor %}

        {% if not has_rows %}
            {% include 'my/bookings/empty.html.twig' with { 'tab': tab } only %}
        {% endif %}
    </div>
</main>
{% endblock %}
