{# Everything about a booking that does not fit on one line: the full timeline
   per direction, then the receipt. Shared by the card's collapse and the
   booking's own page, which shows it open. #}
{% for half in halves %}
    {% if half.direction %}
        <p class="booking-card__label">{{ half.label }}</p>
        {% include 'search/cards/itinerary-detail.html.twig' with { 'direction': half.direction } only %}
    {% endif %}
{% endfor %}

<p class="booking-card__label">Receipt</p>
<dl class="order__prices">
    <div class="order__price-row">
        <dt>{{ booking.passengers|length > 1 ? 'Passengers' : 'Passenger' }}</dt>
        <dd>
            {% for traveller in booking.passengers %}
                {{ traveller.name }}{% if booking.passengers|length > 1 %} <span class="text-muted">({{ traveller.type|lower }})</span>{% endif %}{{ not loop.last ? '<br />'|raw : '' }}
            {% else %}
                {{ booking.passenger }}
            {% endfor %}
        </dd>
    </div>
    {% if booking.contact_email %}
        <div class="order__price-row">
            <dt>Contact</dt>
            <dd>{{ booking.contact_email }}{% if booking.contact_phone %} &middot; {{ booking.contact_phone }}{% endif %}</dd>
        </div>
    {% endif %}
    {% if booking.fare_brand %}
        <div class="order__price-row">
            <dt>Fare</dt>
            <dd>
                {{ booking.fare_brand }}
                {# The terms as they were sold, marked the same way checkout
                   marked them, so what was agreed to and what is shown back
                   read identically. Older bookings kept only the brand name. #}
                {% if booking.fare_rules %}
                    <ul class="rules__list rules__list--compact">
                        {% for line in booking.fare_rules %}
                            <li class="rules__item{{ line.allowed ? '' : ' rules__item--restricted' }}">
                                <i class="fas {{ line.allowed ? 'fa-check' : 'fa-xmark' }} rules__icon"></i>
                                {{ line.text }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </dd>
        </div>
    {% endif %}
    {% if booking.price_total %}
        <div class="order__price-row">
            <dt>Base</dt>
            <dd>${{ booking.price_base.whole }}.{{ booking.price_base.cents }}</dd>
        </div>
        <div class="order__price-row">
            <dt>Taxes &amp; fees</dt>
            <dd>${{ booking.price_tax.whole }}.{{ booking.price_tax.cents }}</dd>
        </div>
        <div class="order__price-row order__price-row--total">
            <dt>Total paid</dt>
            <dd>${{ booking.price_total.whole }}.{{ booking.price_total.cents }}</dd>
        </div>
    {% endif %}
</dl>
