<!-- No results found -->
<div class="col-xl-8 col-lg-8 col-md-12 order-md-1">
    <div class="page-wrapper">
        <div class="wrapper pb-5">
            {% if sidebar.any_applied %}
                {# The filters are the reason, and they are recoverable — say so
                   rather than implying the route has nothing on it. This is the
                   dead end you land in after changing one half of a round trip:
                   filters chosen for one direction rarely fit the other. #}
                <h1 class="mt-0">
                    No flights match your filters
                    <i class="far fa-lg fa-face-frown"></i>
                </h1>
                <p class="pt-2 text-muted">
                    from <strong>{{ depart_city }}</strong> to <strong>{{ arrive_city }}</strong>,
                    {{ step == 2 ? return_date : depart_date }}
                </p>
                <hr class="mt-3 mb-3" />
                <p class="h5">
                    {% if step %}
                        There are flights on this leg, but none of them get past the filters you
                        set. Filters apply to whichever leg you are choosing, so ones that suited
                        the other direction may leave nothing here.
                    {% else %}
                        There are flights on this route, but none of them get past the filters you set.
                    {% endif %}
                </p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a href="{{ sidebar.clear_url }}" class="btn btn-primary">
                        <i class="fas fa-rotate-left pe-1"></i>
                        Clear filters and show every flight
                    </a>
                </div>
                <p class="small text-muted mt-3 mb-0">Your selected flights are kept.</p>
            {% else %}
                <h1 class="mt-0">
                    No flights found
                    <i class="far fa-lg fa-face-frown"></i>
                </h1>
                <p class="pt-2 text-muted">from <strong>{{ depart_city }}</strong> to <strong>{{ arrive_city }}</strong>, {{ depart_date }}{% if return_date %} to {{ return_date }}{% endif %}</p>
                <hr class="mt-3 mb-3"/>
                <p class="h5 pb-5">Aww yeah, seems we are not found any flight for this direction. Try to change your
                    dates or destination. And, sure, you can always <a href="#">subscribe</a> to this direction to get
                    alert for new flight.</p>
                <img src="{{ not_found_img }}" alt="No results found" title="No results found" class="img-fluid" />
            {% endif %}
        </div>
    </div>
</div>
<!-- End / No results found -->
