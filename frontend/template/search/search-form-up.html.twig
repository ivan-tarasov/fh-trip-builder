{# The results-page header form. All of it now lives in search/form.html.twig --
   this file is the band it sits in, and the mapping from the page's variables to
   the partial's. #}
<div class="searchbar-band">
    <div class="container">
        {% include 'search/form.html.twig' with {
            'variant': 'bar',
            'party': party,
            'places': places,
            'recent': recent,
            'depart_code': depart_code,
            'arrive_code': arrive_code,
            'depart_city': depart_city,
            'arrive_city': arrive_city,
            'depart_date': depart_date,
            'return_date': return_date,
            'cabin_value': cabin.value|default('economy')
        } only %}
    </div>
</div>
