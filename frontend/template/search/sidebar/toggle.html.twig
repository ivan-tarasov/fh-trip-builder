{# One switch. Unavailable means turning it on would leave no flights at all,
   so it reads the same as an unavailable option anywhere else. #}
<label class="filter-toggle{{ toggle.available ? '' : ' is-unavailable' }}">
    <span class="filter-toggle__text">
        {{ toggle.label }}
        {% if toggle.hint %}
            <i class="fas fa-info-circle filter-toggle__info"
               data-toggle="tooltip" data-placement="top" title="{{ toggle.hint }}"></i>
        {% endif %}
        {% if not toggle.available %}<span class="filter-row__none">no flights</span>{% endif %}
    </span>
    <span class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" name="{{ name }}" value="1"
               {{ toggle.on ? ' checked' : '' }}{{ toggle.available ? '' : ' disabled' }} />
    </span>
</label>
