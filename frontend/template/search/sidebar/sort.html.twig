<div class="list-group list-group-checkable d-grid gap-2 border-0 w-auto my-2{{ params[triptype] != 1 ? ' d-none' : '' }}">
    <input type="radio"
           class="list-group-item-check pe-none"
           name="sort"
           id="sort{{ params.id }}"
           value="{{ key }}"
           onClick="document.getElementById('form_sort').submit()"
           {{ session_sort == key ? 'checked' : '' }}
    />
    <label class="list-group-item rounded-3 py-3 sort-option" for="sort{{ params.id }}">
        <i class="fas {{ params.icon|default('fa-sort') }} sort-option__icon"></i>
        <span class="sort-option__text">
            {{ params.title }}
            <span class="d-block small opacity-50">{{ params.note }}</span>
        </span>
    </label>
</div>
