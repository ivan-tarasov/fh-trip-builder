<div class="form-check form-switch ms-2">
  <input type="checkbox"
         role="switch"
         class="form-check-input mt-0"
         id="{{ airline.code }}"
         name="airlines[]"
         value="{{ airline.code }}"
         checked
  />
  <label class="form-check-label" for="{{ airline.code }}">{{ airline.title }}</label>
</div>
