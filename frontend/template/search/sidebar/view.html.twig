<!-- SIDEBAR -->
<div class="col-xl-4 col-lg-4 col-md-12 order-md-1 mb-4">

    <!-- Get fare alerts BUTTON -->
    <div class="d-grid gap-2">
        <button type="button" class="btn btn-outline-primary btn-lg btn-block empty-link mb-4">
            <i class="fas pr-1 fa-bell"></i>
            Get fare alerts
        </button>
    </div>
    <!-- End / Get fare alerts BUTTON -->

    <div class="card filters mb-5">
        <div class="card-body">

            {# Sorting applies on its own, against the filters already applied.
               It carries them as hidden fields rather than reading the filter
               form, so choosing a sort never commits a half-set filter. #}
            <form method="get" action="{{ form_path }}" id="form_sort">
                {% for name, value in carried_query %}
                    {% if value is iterable %}
                        {% for item in value %}<input type="hidden" name="{{ name }}[]" value="{{ item }}" />{% endfor %}
                    {% else %}
                        <input type="hidden" name="{{ name }}" value="{{ value }}" />
                    {% endif %}
                {% endfor %}

                {% embed 'search/sidebar/section.html.twig' with { 'id': 'sort', 'title': 'Sort' } %}
                    {% block body %}
                        {% for key, params in config('search.sort') %}
                            {% include 'search/sidebar/sort.html.twig' %}
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            </form>

            {# Everything else applies together. One form, so Apply submits the
               whole sidebar — per-group forms would each have to carry copies
               of every other group's state and would drop whatever they missed. #}
            <form method="get" action="{{ form_path }}" id="form_filters">
                {% for name, value in carried_search %}
                    {% if value is iterable %}
                        {% for item in value %}<input type="hidden" name="{{ name }}[]" value="{{ item }}" />{% endfor %}
                    {% else %}
                        <input type="hidden" name="{{ name }}" value="{{ value }}" />
                    {% endif %}
                {% endfor %}
                {# Only when it is not the default, so a plain search stays clean. #}
                {% if session_sort != 'price' %}
                    <input type="hidden" name="sort" value="{{ session_sort }}" />
                {% endif %}

                {# --- Stops --- #}
                {% embed 'search/sidebar/section.html.twig' with { 'id': 'stops', 'title': 'Stops' } %}
                    {% block body %}
                        {% include 'search/sidebar/checklist.html.twig' with {
                            'id': 'stops', 'name': sidebar.prefix ~ 'stops', 'options': sidebar.stops
                        } only %}
                    {% endblock %}
                {% endembed %}

                {# --- Layover conditions --- #}
                {% embed 'search/sidebar/section.html.twig' with { 'id': 'conditions', 'title': 'Layover conditions', 'open': sidebar.active.conditions } %}
                    {% block body %}
                        {% for name, toggle in sidebar.toggles %}
                            {% include 'search/sidebar/toggle.html.twig' with { 'name': sidebar.prefix ~ name, 'toggle': toggle } only %}
                        {% endfor %}
                    {% endblock %}
                {% endembed %}

                {# --- Price --- #}
                {% if sidebar.sliders.max_price %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'price', 'title': 'Price', 'open': sidebar.active.price } %}
                        {% block body %}
                            {% include 'search/sidebar/slider.html.twig' with {
                                'id': 'max_price', 'name': sidebar.prefix ~ 'max_price', 'kind': 'money', 'label': 'Up to',
                                'min': sidebar.sliders.max_price.min, 'max': sidebar.sliders.max_price.max,
                                'step': sidebar.sliders.max_price.step, 'value': sidebar.sliders.max_price.value,
                                'display': '$' ~ sidebar.sliders.max_price.value|number_format
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {# --- Travel time --- #}
                {% if sidebar.sliders.max_duration %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'duration', 'title': 'Travel time', 'open': sidebar.active.duration } %}
                        {% block body %}
                            {% include 'search/sidebar/slider.html.twig' with {
                                'id': 'max_duration', 'name': sidebar.prefix ~ 'max_duration', 'kind': 'minutes', 'label': 'Up to',
                                'min': sidebar.sliders.max_duration.min, 'max': sidebar.sliders.max_duration.max,
                                'step': sidebar.sliders.max_duration.step, 'value': sidebar.sliders.max_duration.value,
                                'display': sidebar.sliders.max_duration.value
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {# --- Departure / arrival time of day --- #}
                {% embed 'search/sidebar/section.html.twig' with { 'id': 'times', 'title': 'Flight times', 'open': sidebar.active.times } %}
                    {% block body %}
                        <div class="filter-subhead">Departure</div>
                        {% include 'search/sidebar/pills.html.twig' with {
                            'name': sidebar.prefix ~ 'dep_when', 'options': sidebar.depart_buckets
                        } only %}

                        <div class="filter-subhead mt-3">Arrival</div>
                        {% include 'search/sidebar/pills.html.twig' with {
                            'name': sidebar.prefix ~ 'arr_when', 'options': sidebar.arrive_buckets
                        } only %}
                    {% endblock %}
                {% endembed %}

                {# --- Arrival date --- #}
                {% if sidebar.arrive_dates|length > 1 %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'arrdate', 'title': 'Arrival date', 'select_all': true, 'open': sidebar.active.arrdate } %}
                        {% block body %}
                            {% include 'search/sidebar/checklist.html.twig' with {
                                'id': 'arrdate', 'name': sidebar.prefix ~ 'arr_date', 'options': sidebar.arrive_dates
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {# --- Airlines --- #}
                {% if sidebar.airlines %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'airlines', 'title': 'Airlines', 'select_all': true, 'open': sidebar.active.airlines } %}
                        {% block body %}
                            {% include 'search/sidebar/checklist.html.twig' with {
                                'id': 'airlines', 'name': sidebar.prefix ~ 'airlines', 'options': sidebar.airlines,
                                'search': true, 'limit': 8, 'placeholder': 'Airline, IATA code'
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {# --- Layover airports --- #}
                {% if sidebar.layover_airports %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'via', 'title': 'Layover airports', 'select_all': true, 'open': sidebar.active.via } %}
                        {% block body %}
                            {% include 'search/sidebar/checklist.html.twig' with {
                                'id': 'via', 'name': sidebar.prefix ~ 'via', 'options': sidebar.layover_airports,
                                'search': true, 'limit': 8, 'placeholder': 'Airport, city, country, code'
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {# --- Airports at either end, only where there is a choice --- #}
                {% if sidebar.depart_airports|length > 1 %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'fromap', 'title': 'Departure airports', 'select_all': true, 'open': sidebar.active.fromap } %}
                        {% block body %}
                            {% include 'search/sidebar/checklist.html.twig' with {
                                'id': 'fromap', 'name': sidebar.prefix ~ 'from_ap', 'options': sidebar.depart_airports
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {% if sidebar.arrive_airports|length > 1 %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'toap', 'title': 'Arrival airports', 'select_all': true, 'open': sidebar.active.toap } %}
                        {% block body %}
                            {% include 'search/sidebar/checklist.html.twig' with {
                                'id': 'toap', 'name': sidebar.prefix ~ 'to_ap', 'options': sidebar.arrive_airports
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {# --- Aircraft --- #}
                {% if sidebar.aircraft %}
                    {% embed 'search/sidebar/section.html.twig' with { 'id': 'aircraft', 'title': 'Aircraft', 'select_all': true, 'open': sidebar.active.aircraft } %}
                        {% block body %}
                            {% include 'search/sidebar/checklist.html.twig' with {
                                'id': 'aircraft', 'name': sidebar.prefix ~ 'aircraft', 'options': sidebar.aircraft,
                                'search': true, 'limit': 8, 'placeholder': 'Aircraft model'
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

            </form>

            {# Held against the bottom of the screen for as long as any of the
               sidebar is in view, so Apply is never somewhere you have to go
               looking for. It sits outside the form and reaches it by id —
               being the last thing in the card is what gives sticky the room
               to hold it there. #}
            <div class="filters__apply">
                <button type="submit" form="form_filters" class="btn btn-primary w-100">Apply filters</button>
                {% if sidebar.any_applied %}
                    <a href="{{ sidebar.clear_url }}" class="filters__clear">Clear all filters</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<!-- End / SIDEBAR -->
