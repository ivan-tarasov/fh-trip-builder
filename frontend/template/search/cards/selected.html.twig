{# The outbound already chosen, kept in view while the return is picked. #}
<div class="card mb-4 border-success-subtle bg-success-subtle">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small fw-semibold text-success-emphasis text-uppercase">
                <i class="fas fa-check-circle pe-1"></i>Departing flight selected
            </span>
            <a href="{{ change_url }}" class="btn btn-sm btn-outline-secondary">Change</a>
        </div>
        <div class="row align-items-center">
            <div class="col-lg-9">
                {% include 'search/cards/itinerary.html.twig' with { 'direction': selected } %}
            </div>
            <div class="col-lg-3 text-center border-start">
                <div class="h5 mb-0">CAD {{ selected_price }}</div>
                <div class="small text-muted">this flight</div>
            </div>
        </div>
    </div>
</div>
