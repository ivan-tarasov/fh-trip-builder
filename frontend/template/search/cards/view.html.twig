<!-- Flights cards -->
<div class="col-xl-9 col-md-12 order-md-1">
    <div class="page-wrapper">
        <div class="wrapper pb-0">
            {% include 'search/cards/step-header.html.twig' %}

            {% if step == 3 %}
                {# Both halves chosen: show the trip, not more options. #}
                {% include 'search/cards/package.html.twig' %}
            {% else %}
                {% if selected %}
                    {% include 'search/cards/selected.html.twig' %}
                {% endif %}

                {% for flight in flights %}
                    {% include 'search/cards/body.html.twig' %}
                {% endfor %}

                {% if pagination %}
                    {% include 'search/pagination/view.html.twig' %}
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
<!-- End / Flights cards -->
