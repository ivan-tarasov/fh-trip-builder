<!-- Flights cards -->
{# Full width once the sidebar goes, so the review step reads as its own page
   rather than a list with the list taken out. #}
<div class="{{ step == 3 ? 'col-12 search-results--full' : 'col-xl-8 col-lg-8 col-md-12' }} order-md-1 search-results">
    <div class="page-wrapper">
        <div class="wrapper pb-0">
            {% include 'search/cards/step-header.html.twig' %}

            {% if step != 3 and sort_tabs.primary %}
                <div class="results-block results-block--sort">
                    {% include 'search/cards/sort-tabs.html.twig' %}
                </div>
            {% endif %}

            {% if step == 3 %}
                {# Both halves chosen: show the trip, not more options. #}
                {% include 'search/cards/package.html.twig' %}
            {% else %}
                {% if selected %}
                    {% include 'search/cards/selected.html.twig' %}
                {% endif %}

                {# Everything the list grows into lives in one container, so a
                   "load more" appends into the same place the first ten sit. #}
                {# Growing the list gives a screen reader no cue, so the
                   count is announced when new cards arrive. #}
                <p class="visually-hidden js-results-live" role="status" aria-live="polite"></p>

                <div class="js-results">
                    {% include 'search/cards/list.html.twig' %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
<!-- End / Flights cards -->
