{#
    Review & book: the assembled round trip.

    Nothing here is a list, so there is nothing to filter and no sort to choose
    — the sidebar is dropped and the page runs full width. Two questions only:
    are these the right two flights, and what does the ticket allow. Either half
    can still be swapped, which is why this step exists at all rather than
    going straight from the return leg to checkout.

    The rail on the right carries the price and the one action, in the same
    shape checkout uses for its order summary, so moving between the two pages
    does not feel like arriving somewhere else.
#}
<div class="review">

    <div class="review__halves">
        {% for half in [
            { 'label': 'Departing', 'icon': 'fa-plane-departure', 'direction': selected,
              'date': depart_date_label, 'change': change_url },
            { 'label': 'Returning', 'icon': 'fa-plane-arrival', 'direction': selected_return,
              'date': return_date_label, 'change': change_return_url }
        ] %}
            {% if half.direction %}
                <section class="review__half">
                    <header class="review__half-head">
                        <div>
                            <p class="review__half-label">
                                <i class="fas {{ half.icon }}"></i> {{ half.label }}
                            </p>
                            <p class="review__half-date">{{ half.date|date('D, j M Y') }}</p>
                        </div>
                        {# The price used to sit here, immediately left of this
                           link, which read as an offer to change the price. It
                           was also the same figure the rail already itemises
                           below, so removing it costs nothing and the action is
                           left saying what it changes. #}
                        <a href="{{ half.change }}" class="review__change">
                            Change {{ half.label|lower }} flight
                        </a>
                    </header>

                    {% include 'search/cards/itinerary.html.twig' with { 'direction': half.direction } only %}

                    {# Open, with no toggle. This is the last screen before
                       payment and there are only two flights on it: the
                       question being asked is "are these the right ones", and
                       hiding the answer behind a button asks it badly. The
                       search page keeps its toggle, because there the same
                       detail is one of many rows. #}
                    <div class="review__detail">
                        {% include 'search/cards/itinerary-detail.html.twig' with { 'direction': half.direction } only %}
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </div>

    <aside class="review__rail">
        <div class="order">
            <h2 class="order__heading">Trip total</h2>

            <p class="review__total">
                <span class="price price--lg">
                    <span class="price__symbol">$</span><span class="price__whole">{{ package_price.whole }}</span><span class="price__cents">.{{ package_price.cents }}</span>
                    <span class="price__currency">CAD</span>
                </span>
            </p>

            <dl class="order__prices">
                <div class="order__price-row">
                    <dt>Departing</dt>
                    <dd>${{ selected_price }}</dd>
                </div>
                <div class="order__price-row">
                    <dt>Returning</dt>
                    <dd>${{ selected_return_price }}</dd>
                </div>
            </dl>

            <p class="order__note">{{ party_label }}, all taxes and fees included.</p>

            <a class="checkout__pay"
               href="/checkout?depart_itin={{ package_ids.outbound }}{% if package_ids.return %}&amp;return_itin={{ package_ids.return }}{% endif %}{% if cabin is defined and cabin.value != 'economy' %}&amp;class={{ cabin.value }}{% endif %}{{ checkout_pax|default('')|raw }}">
                Continue to checkout <i class="fas fa-arrow-right ps-1"></i>
            </a>
        </div>

        {% if included %}
            {# What the fare allows, before a form has to be filled in. Finding
               out at payment that no bag is included is the point at which
               people leave — and here the flights can still be changed. #}
            <div class="rules">
                <h2 class="rules__heading">What&rsquo;s included</h2>

                {% for block in included %}
                    <div class="rules__block">
                        <p class="rules__route">
                            {{ block.leg }}
                            <span class="rules__brand">{{ block.title }}</span>
                        </p>
                        <ul class="rules__list">
                            {% for line in block.lines %}
                                <li class="rules__item{{ line.allowed ? '' : ' rules__item--restricted' }}">
                                    <i class="fas {{ line.allowed ? 'fa-check' : 'fa-xmark' }} rules__icon"></i>
                                    {{ line.text }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}

                <p class="rules__more">Full rules and restrictions are shown at checkout.</p>
            </div>
        {% endif %}
    </aside>
</div>
