{# Sorting above the results, with the outcome on the control: cheapest and
   quickest are rarely the same itinerary, and the choice is blind unless both
   numbers are visible before you make it.

   One connected bar rather than separate cards — these are three readings of
   the same list, so they belong in one control, and the prices line up as a
   row to be compared at a glance. #}
<div class="sort-bar">
    {% for tab in sort_tabs.primary %}
        <a href="{{ tab.url }}" class="sort-bar__tab{{ tab.current ? ' is-current' : '' }}"
           {{ tab.current ? 'aria-current="true"' : '' }}>
            <span class="sort-bar__label">{{ tab.title }}</span>
            {% if tab.price %}
                <span class="sort-bar__price">${{ tab.price.whole }}</span>
                <span class="sort-bar__meta">{{ tab.duration }}</span>
            {% else %}
                <span class="sort-bar__price sort-bar__price--none">&mdash;</span>
                <span class="sort-bar__meta">{{ tab.note }}</span>
            {% endif %}
        </a>
    {% endfor %}

    {% if sort_tabs.more %}
        <div class="sort-bar__more">
            <label class="visually-hidden" for="sortMore">Other ways to sort</label>
            <select id="sortMore" class="sort-bar__select js-sort-select">
                <option value="">Sort</option>
                {% for tab in sort_tabs.more %}
                    <option value="{{ tab.url }}"{{ tab.current ? ' selected' : '' }}>
                        {{ tab.title }}{% if tab.price %} · ${{ tab.price.whole }}{% endif %}
                    </option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
</div>
