{# Sorting above the results rather than in the sidebar, with the outcome on
   the control: cheapest and quickest are rarely the same itinerary, and the
   choice is blind unless both numbers are visible before you make it. #}
<div class="sort-tabs">
    {% for tab in sort_tabs.primary %}
        <a href="{{ tab.url }}" class="sort-tab{{ tab.current ? ' is-current' : '' }}"
           {{ tab.current ? 'aria-current="true"' : '' }}>
            <span class="sort-tab__title">
                <i class="fas {{ tab.icon }} pe-1"></i>{{ tab.title }}
            </span>
            {% if tab.price %}
                <span class="sort-tab__outcome">${{ tab.price.whole }}{% if tab.duration %}<span class="sort-tab__dot">&middot;</span>{{ tab.duration }}{% endif %}</span>
            {% else %}
                <span class="sort-tab__outcome sort-tab__outcome--empty">{{ tab.note }}</span>
            {% endif %}
        </a>
    {% endfor %}

    {% if sort_tabs.more %}
        <div class="sort-tabs__more">
            <label class="sort-tabs__more-label" for="sortMore">Or sort by</label>
            <select id="sortMore" class="form-select form-select-sm js-sort-select">
                <option value="">Choose…</option>
                {% for tab in sort_tabs.more %}
                    <option value="{{ tab.url }}"{{ tab.current ? ' selected' : '' }}>
                        {{ tab.title }}{% if tab.price %} — ${{ tab.price.whole }}{% if tab.duration %}, {{ tab.duration }}{% endif %}{% endif %}
                    </option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
</div>
