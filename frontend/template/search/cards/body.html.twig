<div class="text-left badge-flight">&nbsp;</div>
<div class="card mb-0 shadow-sm">
    <div class="card-body">
        <div class="row">
            <!-- FLIGHTS (compact, one line per direction) -->
            <div class="col-lg-9 pe-lg-4">
                {% for direction in flight.directions %}
                    {% if not loop.first %}<hr class="my-1" />{% endif %}
                    {% include 'search/cards/itinerary.html.twig' %}
                {% endfor %}
            </div>
            <!-- End / FLIGHTS -->
            <!-- PRICE + ACTIONS -->
            <div class="col-lg-3 border-start text-center d-flex flex-column justify-content-center pt-3 pt-lg-0">
                <div class="h3 mb-0">CAD {{ flight.price_total }}</div>
                <div class="small text-muted mb-3" data-toggle="tooltip" data-placement="top"
                     title="Base ${{ flight.price_base }} plus taxes ${{ flight.price_tax }} (GST ${{ flight.price_gst }}, QST ${{ flight.price_qst }})">
                    total per passenger <i class="fas fa-info-circle"></i>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm mb-2 empty-link">
                    <i class="far fa-bell pe-1"></i>Set price alert
                </button>
                <div class="d-grid">
                    <button type="button" class="btn btn-buy"
                            id="addTrip_{{ flight.outbound_ids|join('-') }}_{{ flight.return_ids|join('-') }}"
                            data-flight-departing-ids="{{ flight.outbound_ids|join(',') }}"
                            data-flight-returning-ids="{{ flight.return_ids|join(',') }}">
                        Select
                    </button>
                </div>
            </div>
            <!-- End / PRICE + ACTIONS -->
        </div>
        <!-- Show flight details -->
        <div class="border-top mt-3 pt-1">
            <button class="btn btn-sm btn-link text-decoration-none collapsed flight-details-toggle" type="button"
                    data-bs-toggle="collapse" data-bs-target="#details-{{ flight.outbound_ids|first }}" aria-expanded="false">
                <span class="if-collapsed">Show flight details</span>
                <span class="if-expanded">Hide flight details</span>
                <i class="fas fa-chevron-down ps-1 chevron"></i>
            </button>
            <div class="collapse" id="details-{{ flight.outbound_ids|first }}">
                <div class="pt-2">
                    {% for direction in flight.directions %}
                        {% include 'search/cards/itinerary-detail.html.twig' %}
                    {% endfor %}
                </div>
            </div>
        </div>
        <!-- End / Show flight details -->
    </div>
</div>
