{# Expanded detail for one direction, as a vertical timeline rather than a row
   of columns.

   The collapsed card already draws the journey as a bar; dropping to a
   four-column table here meant the *detailed* view carried less structure
   than the summary above it. A rail with a node per airport puts departure
   above arrival, spaces layovers between segments, and keeps working at two
   and three stops instead of stacking four more anonymous rows.

   What is gone: the Wi-Fi / entertainment / power / meal icons. They were
   hardcoded, so every segment of every flight claimed all four -- the page
   asserting amenities no data anywhere in this app knows about. They come
   back when a supplier actually sends them.

   What is here instead is the aircraft and the seat, which the fleet tables do
   know: the type flying the leg, and the layout and pitch of the cabin being
   priced. Each line is printed only when its value exists, so a leg whose type
   is unknown loses the block rather than showing an empty one. #}
<div class="legs">
    {# A date is only worth printing when it changes. On a same-day connection
       the old markup repeated "Thu, 03 Sep" once per node; now the first
       departure establishes the day and nothing restates it until midnight is
       crossed -- which is also the one date that gets emphasis. #}
    {% set shown_date = null %}
    {% for segment in direction.segments %}
        <div class="leg">
            <div class="leg__rail" aria-hidden="true"></div>

            <div class="leg__stop">
                <span class="leg__time">{{ segment.depart_time }}</span>
                <span class="leg__place">{{ segment.depart_city }} <span class="leg__code">{{ segment.depart_code }}</span></span>
                {% if segment.depart_date != shown_date %}
                    <span class="leg__date{{ shown_date is not null ? ' leg__date--next' : '' }}">{{ segment.depart_date }}</span>
                    {% set shown_date = segment.depart_date %}
                {% endif %}
            </div>

            <div class="leg__carrier">
                <img class="leg__logo" src="{{ segment.logo_url }}" alt="" width="28" height="28" />
                <span class="leg__airline">{{ segment.carrier_name }}</span>
                {# The aircraft used to be appended here. It moved to the facts
                   row below, which says the same thing and adds the body type,
                   so keeping both printed the type twice per segment. #}
                <span class="leg__meta">{{ segment.flight_number }}</span>
                {# Cabin is omitted rather than guessed when the code does not
                   resolve -- see CABIN_NAMES in ItineraryPresenter. #}
                <span class="leg__meta">{{ segment.duration }}{% if segment.cabin %} · {{ segment.cabin }}{% endif %}</span>
            </div>

            <div class="leg__stop">
                <span class="leg__time">{{ segment.arrive_time }}</span>
                <span class="leg__place">{{ segment.arrive_city }} <span class="leg__code">{{ segment.arrive_code }}</span></span>
                {% if segment.arrive_date != shown_date %}
                    <span class="leg__date leg__date--next">{{ segment.arrive_date }}</span>
                    {% set shown_date = segment.arrive_date %}
                {% endif %}
            </div>

            {% if segment.aircraft or segment.seat_layout or segment.seat_pitch or segment.seat_width %}
                <ul class="leg__facts">
                    {% if segment.aircraft %}
                        <li class="leg__fact">
                            <i class="fas fa-plane leg__fact-icon" aria-hidden="true"></i>
                            <span>{{ segment.aircraft }}{% if segment.aircraft_body %} <span class="leg__fact-note">({{ segment.aircraft_body }})</span>{% endif %}{% if segment.aircraft_seats %}<span class="leg__fact-note">, {{ segment.aircraft_seats }} seats</span>{% endif %}</span>
                        </li>
                    {% endif %}
                    {% if segment.seat_layout %}
                        <li class="leg__fact">
                            <i class="fas fa-grip leg__fact-icon" aria-hidden="true"></i>
                            <span>{{ segment.seat_layout }} seat layout</span>
                        </li>
                    {% endif %}
                    {% if segment.seat_pitch %}
                        <li class="leg__fact">
                            <i class="fas fa-up-right-and-down-left-from-center leg__fact-icon" aria-hidden="true"></i>
                            <span>{{ segment.seat_pitch }} seat pitch{% if segment.seat_flat_bed %}, lies flat{% endif %}</span>
                        </li>
                    {% endif %}
                    {% if segment.seat_width %}
                        <li class="leg__fact">
                            <i class="fas fa-left-right leg__fact-icon" aria-hidden="true"></i>
                            <span>{{ segment.seat_width }} seat width</span>
                        </li>
                    {% endif %}
                </ul>
            {% endif %}
        </div>

        {% if direction.layovers[loop.index0] is defined %}
            <div class="leg__layover">
                <i class="far fa-clock" aria-hidden="true"></i>
                {{ direction.layovers[loop.index0].wait }} in {{ direction.layovers[loop.index0].airport_city }}
            </div>
        {% endif %}
    {% endfor %}

    {# On a direct flight this only repeats the transit time in the row above. #}
    {% if direction.layovers is not empty %}
        <p class="legs__total">Total including layovers: <strong>{{ direction.duration }}</strong></p>
    {% endif %}
</div>
