{% extends 'layout.html.twig' %}

{% block title %}Airports we fly from{% endblock %}

{% block description %}Every airport in our schedules, A to Z, with today's departures and the cheapest fares out of each.{% endblock %}

{# Every airport, as a directory -- the third page built on the component the
   cities and countries use. #}
{% block content %}
<main role="main" class="page-list">
    <div class="container">
        {% include 'partials/directory.html.twig' with {
            'title': 'Airports we fly from',
            'lead': 'Every airport in our schedules, with today\'s schedule and the cheapest fares out of each.',
            'placeholder': 'Start typing an airport, a city or an IATA code',
            'label': 'Filter airports',
            'groups': groups
        } only %}
    </div>
</main>
{% endblock %}
