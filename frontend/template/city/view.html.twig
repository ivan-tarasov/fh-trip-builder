{% extends 'layout.html.twig' %}

{% block title %}Flights to {{ city.name }}{% endblock %}

{# Named, counted and specific, because 231 of these pages exist and a shared
   sentence would make them 231 pages claiming to be about the same thing.
   Reads off the same figures the page shows. #}
{% block description %}Cheap flights to {{ city.name }}, {{ city.country }} — the cheapest direct fares from {{ city.airports > 1 ? city.airports ~ ' airports' : 'its airport' }}, and the cities nearby to fly from instead.{% endblock %}

{# This page draws a map, so it gets Mapbox GL. Five page types do and
   thirteen do not; see the `map` block in layout.html.twig. #}
{% block map %}yes{% endblock %}

{# What this city has to say, in the order it is worth saying. The shell that
   draws it -- the rail, the anchors, the dropping of an empty block -- is in
   partials/place.html.twig and is shared with the country page. #}
{% set blocks = [
    {
        'id': 'general',
        'title': 'General information about ' ~ city.name,
        'nav': 'General information',
        'icon': 'fa-circle-info',
        'tone': 'green',
        'template': 'city/blocks/facts.html.twig',
        'when': true
    },
    {
        'id': 'fares',
        'title': 'Cheap tickets to ' ~ city.name,
        'nav': 'Cheap tickets',
        'icon': 'fa-tag',
        'tone': 'blue',
        'template': 'place/fares.html.twig',
        'when': fares is not empty
    },
    {
        'id': 'airports',
        'title': 'Airports of ' ~ city.name,
        'nav': 'Airports',
        'icon': 'fa-plane-departure',
        'tone': 'orange',
        'template': 'place/airports.html.twig',
        'when': city_airports is not empty
    },
    {
        'id': 'nearby',
        'title': 'Cities near ' ~ city.name,
        'nav': 'Cities nearby',
        'icon': 'fa-location-dot',
        'tone': 'violet',
        'template': 'city/blocks/nearby.html.twig',
        'when': nearby is not empty
    }
] %}

{% block content %}
{% include 'partials/place.html.twig' with {
    'heading': 'Flights to ' ~ city.name ~ ', ' ~ city.country,
    'rail_title': city.name,
    'blocks': blocks,
    'data': {
        'place': city,
        'airports': city_airports,
        'nearby': nearby,
        'fares': fares
    }
} only %}
{% endblock %}
