{# Long pages — a results list that keeps growing most of all — leave the top
   a long way behind. Hidden until there is something to come back from, and
   rendered here so every page has it. #}
<button type="button" class="to-top js-to-top" aria-label="Back to top" hidden>
    <i class="fas fa-chevron-up" aria-hidden="true"></i>
</button>

{# Three bands, and only the first of them varies by page.

   The destinations belong where somebody has not yet said where they are going,
   which is the homepage and nowhere else. `current_page()` returns the raw URL,
   so the test is against '/' -- the same one header.html.twig makes in reverse
   to decide whether the section tray starts in the header. #}
<footer class="footer mt-auto">
    <div class="container footer__inner">
        {% if current_page() == '/' %}
            {% include 'partials/footer/destinations.html.twig' only %}
        {% endif %}

        {% include 'partials/footer/links.html.twig' only %}

        {# The stats come from renderPage()'s context merge rather than from a
           Twig function, so they do not survive `only` and have to be handed
           over by name. #}
        {% include 'partials/footer/bottom.html.twig' with {
            'execution_time': execution_time,
            'database_requests': database_requests,
            'flights_count': flights_count
        } only %}
    </div>
</footer>

<!-- Bootstrap -->
<script src="//cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<!-- Vendor JS-->
<!--script src="{{ cdn(config('site.static.endpoint.vendor')) }}/select2/select2.min.js"></script-->
<script src="{{ cdn(config('site.static.endpoint.vendor')) }}/jquery-validate/jquery.validate.min.js"></script>
<script src="{{ cdn(config('site.static.endpoint.vendor')) }}/bootstrap-wizard/jquery.bootstrap.wizard.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/ion-rangeslider/2.3.0/js/ion.rangeSlider.min.js"></script>
<script src="//use.fontawesome.com/releases/v6.1.1/js/all.js" type="text/javascript" defer integrity="sha384-xBXmu0dk1bEoiwd71wOonQLyH+VpgR1XcDH3rtxrLww5ajNTuMvBdL5SOiFZnNdp" crossorigin="anonymous"></script>
<script src="{{ asset(config('site.directory.js') ~ '/datepicker.js') }}"></script>
<script src="{{ asset(config('site.directory.js') ~ '/global.js') }}"></script>
{# Half a megabyte of it, so only on the five page types that draw a map. #}
{% if needs_map|default(false) %}
    <script src="https://api.mapbox.com/mapbox-gl-js/{{ config('maps.gl_version') }}/mapbox-gl.js"></script>
    <script src="{{ asset(config('site.directory.js') ~ '/map.js') }}"></script>
{% endif %}

</body>
</html>
