# Git folder
.git

# Env file
.env

# PHPStorm project configurations
.idea/

# config for vscode project
.eslintrc.json
.vscode/*

# Composer controlled vendor directory
/vendor/

# Dev-tooling caches
/.phpunit.cache/
/.php-cs-fixer.cache
/.phpstan.cache/

# Compiled Twig templates (keep the directory, ignore its contents)
/cache/twig/*
!/cache/twig/.gitkeep

# Log files
*.log

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Generated MySQL config
config.mysql.php
