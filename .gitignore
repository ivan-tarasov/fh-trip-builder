# Git folder
.git

# Env file
.env

# PHPStorm project configurations
.idea/

# config for vscode project
.eslintrc.json
.vscode/*

# Composer controlled vendor directory
/vendor/

# Cache root (Twig templates + dev-tooling caches); keep the directory only
/cache/*
!/cache/.gitkeep

# Log files
*.log

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Generated MySQL config
config.mysql.php

# Web server config: owned by the host, not the repo. cPanel and similar panels
# rewrite this file (e.g. the PHP handler block), so a tracked copy fights the
# server on every deploy. Copy .htaccess.example into place instead.
/.htaccess

# Airside images are staged here and uploaded, not committed. The bucket holds
# the only copy -- see the funnel's A8.6. `.gitkeep` stays so the directory
# exists on a fresh clone and the importer has somewhere to look.
/frontend/img/airside/*
!/frontend/img/airside/.gitkeep
!/frontend/img/airside/authors/
/frontend/img/airside/authors/*
!/frontend/img/airside/authors/.gitkeep
