parameters:
	ignoreErrors:
		-
			message: '#^Method TripBuilder\\Api\\AbstractApi\:\:sendResponse\(\) has parameter \$data with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Api/AbstractApi.php

		-
			message: '#^Method TripBuilder\\Api\\AbstractApi\:\:sendResponse\(\) has parameter \$headers with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Api/AbstractApi.php

		-
			message: '#^Property TripBuilder\\Api\\AbstractApi\:\:\$data type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Api/AbstractApi.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: src/Api/Airlines/Response.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: src/Api/Airports/Response.php

		-
			message: '#^Property TripBuilder\\Config\:\:\$configData type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Config.php

