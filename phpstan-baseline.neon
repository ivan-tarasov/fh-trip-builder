			identifier: missingType.iterableValue
			count: 1
			path: src/Controllers/AjaxController.php

		-
			message: '#^Property TripBuilder\\Controllers\\AjaxController\:\:\$get type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Controllers/AjaxController.php

		-
			message: '#^Method TripBuilder\\Controllers\\SearchController\:\:setGet\(\) has parameter \$get with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Controllers/SearchController.php


