#!/usr/bin/env php
<?php

declare(strict_types=1);
/*
|--------------------------------------------------------------------------
| Noah Commander
|--------------------------------------------------------------------------
*/

require_once __DIR__ . '/vendor/autoload.php';

use Symfony\Component\Console\Application;
use TripBuilder\Noah\Airside\Import as AirsideImport;
use TripBuilder\Noah\Airside\Prune as AirsidePrune;
use TripBuilder\Noah\Articles\Import as ArticlesImport;
use TripBuilder\Noah\Currency\Rates as CurrencyRates;
use TripBuilder\Noah\Db\Clear as DatabaseClear;
use TripBuilder\Noah\Db\Install as DatabaseInstall;
use TripBuilder\Noah\Db\Migrate as DatabaseMigrate;
use TripBuilder\Noah\Flights\Cabins as CabinsFlights;
use TripBuilder\Noah\Flights\Cleaning as CleaningFlights;
use TripBuilder\Noah\Flights\Generate as GenerateFlights;
use TripBuilder\Noah\Flights\Realign as RealignFlights;
use TripBuilder\Noah\Flights\Reprice as RepriceFlights;

try {
    /*
    |--------------------------------------------------------------------------
    | Application instance
    |--------------------------------------------------------------------------
    */

    $application = new Application();

    /*
    |--------------------------------------------------------------------------
    | Install Database
    |--------------------------------------------------------------------------
    |
    | Adding tables from config files in `config/noah/db/tables` to a database
    | and seeding tables with data from config files in `config/noah/db/seeders`
    |
    */

    $application->add(new DatabaseInstall());

    /*
    |--------------------------------------------------------------------------
    | Clear DB
    |--------------------------------------------------------------------------
    |
    | Purge all data from existing tables in database.
    |
    */

    $application->add(new DatabaseClear());

    /*
    |--------------------------------------------------------------------------
    | Migrate DB
    |--------------------------------------------------------------------------
    |
    | Apply the schema changes app:install cannot make -- a changed type, a
    | dropped column, a new constraint -- and record which have run.
    |
    */

    $application->add(new DatabaseMigrate());

    /*
    |--------------------------------------------------------------------------
    | Generate flights
    |--------------------------------------------------------------------------
    |
    | Generating flights data using existing airports and airlines data,
    | calculating duration between airports, flight time, arrival date and
    | time, base price, taxes and rating. All generated data writing to
    | `flights` table in a database.
    |
    */

    $application->add(new GenerateFlights());

    /*
    |--------------------------------------------------------------------------
    | Cleaning flights
    |--------------------------------------------------------------------------
    |
    | Deleting old flights data from `flights` table in a database.
    | All flights older than the current date will be deleted.
    |
    */

    $application->add(new CleaningFlights());

    /*
    |--------------------------------------------------------------------------
    | Reprice Flights
    |--------------------------------------------------------------------------
    |
    | Recalculating fares on flights already in the network with the current
    | formula in `FarePricing`, in place so bookings keep their flight ids.
    |
    */

    $application->add(new RepriceFlights());

    /*
    |--------------------------------------------------------------------------
    | Cabins on Flights
    |--------------------------------------------------------------------------
    |
    | Adding the `cabins` column and filling in which cabins each flight sells,
    | by the rule in `CabinAvailability`. In place for the same reason as the
    | repricing above -- bookings reference flights by id.
    |
    */

    $application->add(new CabinsFlights());

    /*
    |--------------------------------------------------------------------------
    | Realign Flights
    |--------------------------------------------------------------------------
    |
    | Reassigning the aircraft on flights already in the network with the
    | current rule in `LegBuilder`, and dropping legs longer than anything can
    | fly. Duration, arrival time and cabins all follow from the type.
    |
    */

    $application->add(new RealignFlights());

    /*
    |--------------------------------------------------------------------------
    | Currency Rates
    |--------------------------------------------------------------------------
    |
    | Refreshing what a Canadian dollar buys, from the European Central Bank's
    | reference rates. Stored against the day the ECB published them, so the
    | table is a history and running this twice in an afternoon corrects one row
    | rather than writing two.
    |
    | Deliberately not part of `app:install`: a deploy should not be able to
    | fail because a third party is down, and the seeded rows mean a fresh
    | install already converts.
    |
    */

    $application->add(new CurrencyRates());

    /*
    |--------------------------------------------------------------------------
    | Articles
    |--------------------------------------------------------------------------
    |
    | Loads config/content/help/*.md into the articles tables. There is no
    | seeder CSV for those tables on purpose: `app:install` refreshes every
    | column of every seeded row, so a seeded article would be reverted to the
    | committed copy on every install, and the point of moving articles into
    | the database was that something could edit them.
    |
    | Which means a fresh install does need this, unlike currency:rates. It is
    | in the README's install steps for that reason, alongside flights:add.
    |
    */

    $application->add(new ArticlesImport());

    /*
    |--------------------------------------------------------------------------
    | Airside
    |--------------------------------------------------------------------------
    |
    | Loads config/content/airside/*.md into the posts tables, on the same
    | terms and for the same reason as the articles above: no seeder CSV, so
    | `app:install` cannot revert a post to its committed copy.
    |
    | Deliberately not in the README's install steps yet. There are no posts
    | to import until A8.4 writes them, and this command refuses a run that
    | found nothing -- which is what stops a mistyped directory emptying the
    | table, and would also fail an install that ran it too early.
    |
    */

    $application->add(new AirsideImport());

    /*
    |--------------------------------------------------------------------------
    | Airside housekeeping
    |--------------------------------------------------------------------------
    |
    | The other half of the importer's bargain. It never deletes, because a
    | hashed name means a changed image is a new object rather than a replaced
    | one -- so the bucket only grows, and something has to be able to say what
    | in it nothing points at.
    |
    | Lists by default and deletes only with `--force`. The staging directory is
    | not committed, so the bucket holds the only copy of these files.
    |
    */

    $application->add(new AirsidePrune());

    /*
    |--------------------------------------------------------------------------
    | Run application
    |--------------------------------------------------------------------------
    */

    $application->run();
} catch (Throwable $e) {
    fwrite(STDERR, sprintf('Noah failed: %s: %s%s', $e::class, $e->getMessage(), PHP_EOL));
    exit(1);
}
