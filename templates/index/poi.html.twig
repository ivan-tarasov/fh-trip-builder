{% import 'partials/money.html.twig' as money %}
<div class="col">
    {# Always a real link now -- C8 (#157), redesigned. Every card points at
       the destination's own `/city/<slug>` page, which exists whether or
       not a fare turned up this instant, so there is always somewhere to
       land: no more "styled as a link, does nothing" case to guard against,
       the reason this used to be a plain heading. #}
    <a href="{{ poi.url }}" class="card card-cover poi h-100 overflow-hidden text-bg-dark rounded-4 shadow-lg text-decoration-none" style="background-image: url('{{ cdn(config('site.static.endpoint.poi') ~ '/' ~ poi.image) }}');">
        <div class="d-flex flex-column h-100 p-5 pb-3 text-white text-shadow-1">
            <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 fw-bold">{{ poi.title }}</h3>
            {# This row used to open with the developer's own GitHub avatar,
               alt="Post author" -- inherited from the Bootstrap album example
               the card was built from. A face has nothing to say about Tokyo,
               so the location stands on its own. #}
            <div class="d-flex align-items-center mt-auto">
                <i class="fa-solid fa-location-dot pe-1" aria-hidden="true"></i>
                <small>{{ poi.city }}, {{ poi.country }}</small>
            </div>
            {% if poi.price is not null %}
                {# Not "this month", the way the old, origin-personalised
                   version said it -- this is the same "cheapest direct, from
                   wherever the market is" figure the destination's own page
                   shows, and that page carries no date qualifier either.
                   Sized like `.fare__price` (the same figure's treatment
                   everywhere else it appears on this site), not tucked into
                   a `<small>`: a price on a photo is the thing being sold,
                   not a footnote to the photo. #}
                <p class="poi__price mt-2 mb-0">
                    From {{ money.plain(price_whole(poi.price)) }}
                </p>
            {% endif %}
        </div>
    </a>
</div>
