{% import 'partials/money.html.twig' as money %}
<div class="col">
    <div class="card card-cover h-100 overflow-hidden text-bg-dark rounded-4 shadow-lg" style="background-image: url('{{ cdn(config('site.static.endpoint.poi') ~ '/' ~ poi.image) }}');">
        <div class="d-flex flex-column h-100 p-5 pb-3 text-white text-shadow-1">
            {# A plain heading when there is nothing to lead to, still --
               styled as a link with no href is skipped by the keyboard and
               apologises on click for doing nothing. Where C8 (#157) found
               this month's fare, `stretched-link` makes the whole card the
               target rather than just the words, and the anchor carries the
               title's own text as its content so a screen reader hears
               where the link goes. #}
            {% if poi.url is not null %}
                <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 fw-bold">
                    <a href="{{ poi.url }}" class="link-light text-decoration-none stretched-link">{{ poi.title }}</a>
                </h3>
            {% else %}
                <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 fw-bold">{{ poi.title }}</h3>
            {% endif %}
            {# This row used to open with the developer's own GitHub avatar,
               alt="Post author" -- inherited from the Bootstrap album example
               the card was built from. A face has nothing to say about Tokyo,
               so the location stands on its own. #}
            <div class="d-flex align-items-center justify-content-between mt-auto">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-location-dot pe-1" aria-hidden="true"></i>
                    <small>{{ poi.city }}, {{ poi.country }}</small>
                </div>
                {% if poi.price is not null %}
                    {# "This month", not "from" the way a route page says it:
                       `price_whole()` already reads rough ("$464", no cents),
                       and pairing that with a window makes it a claim rather
                       than the fare's own permanent name. #}
                    <small class="fw-bold">{{ money.whole(price_whole(poi.price)) }} this month</small>
                {% endif %}
            </div>
        </div>
    </div>
</div>
