{% extends 'layout.html.twig' %}

{# Step 3 is no longer a list of options, so naming the route there would
   describe the wrong thing. #}
{% block title %}{% if step == 3 %}Review your trip{% else %}{{ depart_city }} to {{ arrive_city }}{% endif %}{% endblock %}

{% block content %}
{# The landmark this page did not have, around the whole block for the same
   reason the homepage's is: `.searchbar-band` is `position: sticky` above
   992px and a sticky element is measured against its containing block, so
   this box has to be exactly `.page`'s or the band's travel changes. It
   sticks at `top: 0` rather than under the header, because on this page the
   header scrolls away and the band takes the top of the screen.

   The band is inside the landmark and belongs there: on a results page the
   search is content, not chrome -- adjusting a date is what somebody scrolling
   a list of flights is here to do.

   `.filters__apply` in the sidebar is sticky too, and its containing block is
   `DIV.card-body < DIV.card < DIV.col-xl-4`, entirely inside the column, so
   nothing above it moves. Measured, not assumed. #}
<main role="main">
{% include 'search/search-form-up.html.twig' %}
<div class="container py-5">
  <div class="row">

    {# No list at step 3, so nothing to filter. The sidebar would be a column
       of controls that cannot change anything on the page. #}
    {% if step != 3 %}
        {% include 'search/sidebar/view.html.twig' %}
    {% endif %}

    {# Step 3 lists nothing — it shows the assembled package instead. #}
    {% if step == 3 or total_flights != 0 %}
        {% include 'search/cards/view.html.twig' %}
    {% else %}
        {% include 'search/no-result.html.twig' %}
    {% endif %}

  </div>
</div>
</main>
{% endblock %}
