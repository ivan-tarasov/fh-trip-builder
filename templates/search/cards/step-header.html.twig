{# Where the traveller is: departing, then returning, then the assembled trip. #}
<div class="results-block results-block--steps">
    {% if step %}
        <ol class="step-track list-unstyled d-flex align-items-center gap-2 mb-3">
            <li class="step-track__item {{ step == 1 ? 'is-current' : 'is-done' }}">
                <span class="step-track__marker">{% if step > 1 %}<i class="fas fa-check"></i>{% else %}1{% endif %}</span>
                Departing
            </li>
            <li class="step-track__line" aria-hidden="true"></li>
            <li class="step-track__item {{ step == 2 ? 'is-current' : (step > 2 ? 'is-done' : '') }}">
                <span class="step-track__marker">{% if step > 2 %}<i class="fas fa-check"></i>{% else %}2{% endif %}</span>
                Returning
            </li>
            <li class="step-track__line" aria-hidden="true"></li>
            <li class="step-track__item {{ step == 3 ? 'is-current' : '' }}">
                <span class="step-track__marker">3</span>
                Review &amp; book
            </li>
        </ol>
    {% endif %}

</div>

{# The watch button sits with the title rather than in the sort row: it is
   about this route in general, not about the list currently sorted below
   it. Held back at step 3 the same way the sort tabs are -- reviewing an
   assembled trip is not the moment to ask about a future price drop. #}
<div class="results-block results-block--title d-flex align-items-start justify-content-between gap-3 flex-wrap">
    <div>
        <h2 class="h4 mb-1">{{ step_title }}</h2>
        <p class="text-muted mb-0">
            {# The route page for this exact pair, when a nonstop one
               exists to link to -- SearchController::routeUrlFor() already
               checked, so this is never a link to a 404 (C7, #156). Fixed
               to the outbound direction regardless of step: a traveller
               picking their return leg is still exploring the one route,
               not a different page for each direction. #}
            {% if route_url %}<a href="{{ route_url }}">{{ step_route }}</a>{% else %}{{ step_route }}{% endif %}
            {% if step == 3 %}
                &middot; {{ date_label(depart_date_label, 'D, j M', 'D, j M Y', return_date_label) }} &ndash; {{ return_date_label|date('D, j M Y') }}
            {% else %}
                {% if step_date %}
                    {%- if step_date_until and step_date_until != step_date %}
                        &middot; {{ date_label(step_date, 'D, j M', 'D, j M Y', step_date_until) }} &ndash; {{ step_date_until|date('D, j M Y') }}
                    {%- else %}
                        &middot; {{ step_date|date('D, j M Y') }}
                    {%- endif %}
                {% endif %}
                &middot; {{ total_flights_text }}
            {% endif %}
        </p>
    </div>
    {% if step != 3 %}
        {# `.btn-outline-ink`, not `.btn-primary`/`.btn-ink`: this button
           does not move the booking forward and it does not change what
           the list below shows, the two things this page's own button
           colours are reserved for -- see the comment above `.btn-ink` in
           main.css. Same family "Search flights" already uses as a quiet
           secondary action elsewhere on the site. #}
        <button type="button" class="btn btn-sm btn-outline-ink flex-shrink-0"
                data-bs-toggle="modal" data-bs-target="#watch-route-modal">
            <i class="fas fa-bell pe-1" aria-hidden="true"></i> Watch this route
        </button>
        {% include 'search/watch-route-modal.html.twig' %}
    {% endif %}
</div>
