{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'content' %}

{% block title %}{{ category ? 'Edit category' : 'New category' }}{% endblock %}

{% block tools %}<a class="button" href="/admin/content">Back</a>{% endblock %}

{% block content %}
    {% if error %}
        <p class="notice notice--bad" role="alert" aria-live="assertive">{{ error }}</p>
    {% endif %}

    {% if category and category.edited %}
        <p class="notice notice--owned">Edited here, so <code>articles:import</code> leaves it alone.</p>
    {% elseif category %}
        <p class="notice">The files still own this. Saving takes it over, and imports will stop rewriting it.</p>
    {% endif %}

    <form method="post" class="form"
          action="/admin/category{{ category and category.slug ? '/' ~ category.slug : '' }}">
        <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">

        <div class="field">
            <label for="slug">Slug</label>
            {% if category and category.slug %}
                <input id="slug" name="slug" type="text" value="{{ category.slug }}" disabled>
                <p class="field__hint">A slug cannot change &mdash; the articles in this category name it.</p>
            {% else %}
                <input id="slug" name="slug" type="text" required
                       pattern="[a-z0-9][a-z0-9-]*" maxlength="64"
                       value="{{ category.slug|default('') }}"
                       autocapitalize="off" spellcheck="false">
                <p class="field__hint">Lower case letters, digits and hyphens.</p>
            {% endif %}
        </div>

        <div class="field">
            <label for="title">Title</label>
            <input id="title" name="title" type="text" required maxlength="255"
                   value="{{ category.title|default('') }}">
        </div>

        <div class="field">
            <label for="summary">Summary</label>
            <textarea id="summary" name="summary" rows="3" required>{{ category.summary|default('') }}</textarea>
            <p class="field__hint">One sentence, shown under the heading on the help hub.</p>
        </div>

        <div class="pair">
            <div class="field">
                <label for="icon">Icon</label>
                <input id="icon" name="icon" type="text" maxlength="64"
                       value="{{ category.icon|default('') }}" autocapitalize="off" spellcheck="false">
                <p class="field__hint">A Font Awesome name, like <code>fa-plane</code>.</p>
            </div>

            <div class="field">
                <label for="accent">Accent</label>
                <input id="accent" name="accent" type="text" maxlength="32"
                       value="{{ category.accent|default(accent) }}" autocapitalize="off" spellcheck="false">
                <p class="field__hint">The colour name the hub card uses.</p>
            </div>
        </div>

        <div class="field">
            <label for="position">Position</label>
            <input id="position" name="position" type="number" min="0" step="1"
                   value="{{ category.position|default(0) }}">
            <p class="field__hint">Lowest first.</p>
        </div>

        <div class="field field--check">
            <label>
                <input type="checkbox" name="enabled" value="1"
                       {{ category is null or category.enabled ? 'checked' : '' }}>
                Show this category on the site
            </label>
        </div>

        <div class="actions">
            <button type="submit" class="button button--go">Save</button>
        </div>
    </form>
{% endblock %}
