{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'content' %}

{% block title %}{{ category ? 'Edit category' : 'New category' }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="/admin/content">Help content</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ block('title') }}</li>
{% endblock %}

{% block tools %}<a class="btn btn-outline-secondary btn-sm" href="/admin/content">Back</a>{% endblock %}

{% block content %}
    {% if error %}
        <p class="notice notice--bad" role="alert" aria-live="assertive">{{ error }}</p>
    {% endif %}

    {% if category and category.edited %}
        <p class="notice notice--owned">Edited here, so <code>articles:import</code> leaves it alone.</p>
    {% elseif category %}
        <p class="notice">The files still own this. Saving takes it over, and imports will stop rewriting it.</p>
    {% endif %}

    <form method="post" action="/admin/category{{ category and category.slug ? '/' ~ category.slug : '' }}">
        <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">

        <div class="card orchid-card mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="slug" class="form-label">Slug</label>
                        {% if category and category.slug %}
                            <input id="slug" name="slug" type="text" class="form-control" value="{{ category.slug }}" disabled>
                            <p class="field__hint">A slug cannot change &mdash; the articles in this category name it.</p>
                        {% else %}
                            <input id="slug" name="slug" type="text" class="form-control" required
                                   pattern="[a-z0-9][a-z0-9-]*" maxlength="64"
                                   value="{{ category.slug|default('') }}"
                                   autocapitalize="off" spellcheck="false">
                            <p class="field__hint">Lower case letters, digits and hyphens.</p>
                        {% endif %}
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="title" class="form-label">Title</label>
                        <input id="title" name="title" type="text" class="form-control" required maxlength="255"
                               value="{{ category.title|default('') }}">
                    </div>

                    <div class="col-12">
                        <label for="summary" class="form-label">Summary</label>
                        <textarea id="summary" name="summary" class="form-control" rows="3" required>{{ category.summary|default('') }}</textarea>
                        <p class="field__hint">One sentence, shown under the heading on the help hub.</p>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="icon" class="form-label">Icon</label>
                        <input id="icon" name="icon" type="text" class="form-control" maxlength="64"
                               value="{{ category.icon|default('') }}" autocapitalize="off" spellcheck="false">
                        <p class="field__hint">A Font Awesome name, like <code>fa-plane</code>.</p>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="accent" class="form-label">Accent</label>
                        <select id="accent" name="accent" class="form-select" required>
                            {% for option in accents %}
                                <option value="{{ option }}"{{ category.accent|default(accent) == option ? ' selected' : '' }}>{{ option }}</option>
                            {% endfor %}
                        </select>
                        <p class="field__hint">The colour the hub card's icon uses.</p>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="position" class="form-label">Position</label>
                        <input id="position" name="position" type="number" class="form-control" min="0" step="1"
                               value="{{ category.position|default(0) }}">
                        <p class="field__hint">Lowest first.</p>
                    </div>

                    <div class="col-6 col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="enabled" name="enabled" value="1"
                                   {{ category is null or category.enabled ? 'checked' : '' }}>
                            <label class="form-check-label" for="enabled">Show this category on the site</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>
{% endblock %}
