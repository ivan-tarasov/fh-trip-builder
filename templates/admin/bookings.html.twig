{% extends 'admin/layout.html.twig' %}
{% import 'partials/money.html.twig' as money %}

{% set admin_section = 'bookings' %}

{# The hero below is this page's title -- there is no second, plainer one
   above it (G7.1, #332). #}
{% set page_header = false %}

{% block title %}Bookings{% endblock %}

{# What this list shows is a decision, and it has been taken twice.

   The first time it left every name off: `bookings` holds an email, a phone
   number, a name, a date of birth and a gender -- PIPEDA scope, which is why
   `db:prune` sweeps it at all.

   The travellers are on it now because finding the right booking is usually
   being done by name. Somebody rings up and says who they are; nobody rings up
   and quotes a database id. A list that cannot be scanned for the name on the
   phone is one an operator opens ten bookings from, and ten pages of contact
   details is worse than one column of names.

   So: names yes, and everything else still no. No address, no phone, no date of
   birth, no card. Those stay on the page for the one booking somebody opened,
   where looking at them was a deliberate act (G1.8, #233). #}
{% block content %}
    {# Every filter that can narrow the list below, carried as one query
       string wherever a link on this page needs to survive it: the range
       pills, the export link and pagination. #}
    {% set filter_parts = [] %}
    {% if term %}{% set filter_parts = filter_parts|merge(['q=' ~ term|url_encode]) %}{% endif %}
    {% if status %}{% set filter_parts = filter_parts|merge(['status=' ~ status.value]) %}{% endif %}
    {% if from %}{% set filter_parts = filter_parts|merge(['from=' ~ from]) %}{% endif %}
    {% if to %}{% set filter_parts = filter_parts|merge(['to=' ~ to]) %}{% endif %}
    {% set filter_qs = filter_parts|join('&') %}

    {# Orchid's own dark hero (`analytics.html`), real numbers in place of
       its fake ones -- made, cancelled, gross cost and a search-to-book
       ratio, each with its own day-by-day chart. Dropped: the "LIVE · N
       visitors online" eyebrow (nothing here tracks a live visitor) and
       the Share button (nowhere to share to in a one-operator panel).
       Export moves in from the old toolbar rather than sitting twice on
       the page (G7.1, #332). #}
    <section class="bookings-hero" aria-labelledby="bookingsHeroTitle">
        <div class="bookings-hero__decor" aria-hidden="true">
            <span class="bookings-hero__grid"></span>
            <span class="bookings-hero__orb bookings-hero__orb--a"></span>
            <span class="bookings-hero__orb bookings-hero__orb--b"></span>
        </div>

        <div class="bookings-hero__head">
            <div>
                <h1 class="bookings-hero__title" id="bookingsHeroTitle">Bookings</h1>
                <p class="bookings-hero__sub">Made, cancelled and booked value{{ range == 'all' ? ', all time.' : (range == '1d' ? ', today.' : ', last ' ~ range ~ '.') }}</p>
            </div>

            <div class="bookings-hero__actions">
                {# A real link per pill, not a client-side re-render -- a
                   range is a URL somebody can reload, bookmark or send to
                   themselves, the same reasoning the search box below
                   already gets for being a GET. #}
                <div class="bookings-range" role="group" aria-label="Date range">
                    {% for value, label in {'1d': '1d', '7d': '7d', '30d': '30d', '90d': '90d', 'all': 'All'} %}
                        <a class="bookings-range__btn{{ range == value ? ' is-active' : '' }}"
                           href="/admin/bookings?range={{ value }}{{ filter_qs ? '&' ~ filter_qs : '' }}"
                           {{ range == value ? 'aria-current="true"' : '' }}>{{ label }}</a>
                    {% endfor %}
                </div>

                <a class="bookings-btn-primary" href="/admin/bookings/export{{ filter_qs ? '?' ~ filter_qs : '' }}">
                    <i class="bi bi-download" aria-hidden="true"></i>Export
                </a>
            </div>
        </div>

        <div class="bookings-hero__kpis">
            {% for card in hero %}
                <div class="bookings-hero__kpi">
                    <div class="bookings-hero__kpi-head">
                        <span class="bookings-hero__kpi-label">{{ card.label }}</span>
                        <span class="bookings-hero__kpi-value">{{ card.display }}</span>
                        {% if card.delta %}
                            <span class="bookings-hero__kpi-delta bookings-hero__kpi-delta--{{ card.delta.good ? 'up' : 'down' }}">
                                <i class="bi bi-arrow-{{ card.delta.pct >= 0 ? 'up' : 'down' }}-right" aria-hidden="true"></i>
                                {{ card.delta.pct|abs|number_format(1) }}%
                            </span>
                        {% else %}
                            <span class="bookings-hero__kpi-delta bookings-hero__kpi-delta--flat">n/a</span>
                        {% endif %}
                    </div>
                    <div class="bookings-hero__kpi-chart">
                        <canvas class="js-chart" data-chart="sparkline" data-tone="{{ card.tone }}"
                                data-points="{{ card.points|json_encode }}" aria-label="{{ card.label }} trend"></canvas>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    {# The list's own toolbar -- unaffected by the hero's range, which is
       about the numbers above, not which rows are listed below. #}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        {# A GET and not a POST, so a search (and its filters) can be linked,
           refreshed and paged. The cost is that the term lands in the access
           log, which is why the box is offered for a reference, a name and
           an address and nothing finer. #}
        <form class="d-flex flex-wrap align-items-center gap-2" method="get" action="/admin/bookings" role="search">
            <label class="visually-hidden" for="find">Search bookings</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-transparent"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input id="find" type="search" class="form-control" name="q" value="{{ term }}" placeholder="Reference, name or address" autocomplete="off">
            </div>

            <label class="visually-hidden" for="filterStatus">Status</label>
            <select id="filterStatus" name="status" class="form-select form-select-sm">
                <option value="">Any status</option>
                {% for s in statuses %}
                    <option value="{{ s.value }}"{{ status == s ? ' selected' : '' }}>{{ s.label() }}</option>
                {% endfor %}
            </select>

            <label class="visually-hidden" for="filterFrom">Booked from</label>
            <input id="filterFrom" type="date" name="from" class="form-control form-control-sm" value="{{ from }}" title="Booked from">

            <label class="visually-hidden" for="filterTo">Booked to</label>
            <input id="filterTo" type="date" name="to" class="form-control form-control-sm" value="{{ to }}" title="Booked to">

            <button class="btn btn-outline-secondary btn-sm" type="submit">Search</button>
            {% if term or status or from or to %}<a class="btn btn-outline-secondary btn-sm" href="/admin/bookings">Clear</a>{% endif %}
        </form>

        <span class="text-body-secondary small">{{ total }} {{ term or status or from or to ? 'found' : 'in all' }}</span>
    </div>

    {% if (term or status or from or to) and bookings is empty %}
        <p class="notice">
            Nothing matches these filters. A search reads the reference, the
            travellers' names and the address the booking was made from.
        </p>
    {% else %}
        <div class="card orchid-card">
            <div class="table-responsive">
                <table class="table orchid-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Reference</th>
                            <th scope="col">Travelling</th>
                            <th scope="col">Route</th>
                            <th scope="col">Departs</th>
                            <th scope="col">Made</th>
                            <th scope="col">Total</th>
                            <th scope="col">State</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for booking in bookings %}
                            <tr>
                                {# The row's own id. What the address is built from, what
                                   a log line quotes, and the one thing about a booking
                                   that is never blank -- a reference is issued at the end
                                   of checkout and a row that did not get there has none. #}
                                <td class="mono text-body-secondary">{{ booking.id }}</td>
                                <td>
                                    <a class="mono text-decoration-none" href="/admin/bookings/{{ booking.id }}">
                                        {{ booking.reference ?: 'no reference' }}
                                    </a>
                                </td>
                                <td>
                                    {{ booking.lead ?: '—' }}
                                    {% if booking.others is not empty %}
                                        <span class="badge text-bg-secondary fw-normal">+{{ booking.others|length }}</span>
                                        {# Named rather than counted only: an operator
                                           looking for the child on a family booking is
                                           looking for a name that is not the lead's. #}
                                        <span class="text-body-secondary small d-block">
                                            {% if booking.others|length > 2 %}
                                                with {{ booking.others|slice(0, 2)|join(', ') }} and {{ booking.others|length - 2 }} more
                                            {% else %}
                                                with {{ booking.others|join(', ') }}
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="mono">
                                    {% if booking.from %}
                                        {{ booking.from }} &rarr; {{ booking.to }}
                                    {% else %}
                                        {# The presenter refuses to draw a booking whose
                                           flights will not build. A traveller should not
                                           see one; an operator should, because it is the
                                           row somebody is calling about. #}
                                        <span class="text-body-secondary">will not build</span>
                                    {% endif %}
                                </td>
                                {# A DateTimeImmutable off the presenter, not a string. #}
                                <td class="mono text-body-secondary">
                                    {% if booking.departs %}{{ booking.departs|date('j M Y') }}{% else %}&mdash;{% endif %}
                                </td>
                                <td class="mono">
                                    {{ booking.created|date('j M Y') }}
                                    {# The date says when, this says how long. Scanning a
                                       list, the second is the question being asked. #}
                                    <span class="text-body-secondary small d-block">{{ booking.made_ago }}</span>
                                </td>
                                <td class="mono">
                                    {% if booking.price_total %}{{ money.whole(booking.price_total) }}{% else %}&mdash;{% endif %}
                                </td>
                                <td>
                                    <span class="status-chip{{ booking.is_cancelled ? ' status-chip--bad' : ' status-chip--good' }}">
                                        <i class="bi bi-{{ booking.is_cancelled ? 'x-circle-fill' : 'check-circle-fill' }}" aria-hidden="true"></i>
                                        {{ booking.status_label }}
                                    </span>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="8" class="text-body-secondary">Nobody has booked anything yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if total > per_page %}
            {# The search and its filters survive paging, or page two of a
               search is page two of everything and the operator loses what
               they set. #}
            {% set carry = filter_qs ? '&' ~ filter_qs : '' %}

            <div class="d-flex align-items-center justify-content-between mt-3">
                <span class="text-body-secondary small">
                    {{ (page - 1) * per_page + 1 }}&ndash;{{ min(page * per_page, total) }} of {{ total }}
                </span>

                <nav aria-label="Booking pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item{{ page > 1 ? '' : ' disabled' }}">
                            <a class="page-link" href="/admin/bookings?page={{ page - 1 }}{{ carry }}"{{ page > 1 ? '' : ' tabindex="-1" aria-disabled="true"' }}>
                                <i class="bi bi-chevron-left" aria-hidden="true"></i> Newer
                            </a>
                        </li>
                        <li class="page-item{{ page * per_page < total ? '' : ' disabled' }}">
                            <a class="page-link" href="/admin/bookings?page={{ page + 1 }}{{ carry }}"{{ page * per_page < total ? '' : ' tabindex="-1" aria-disabled="true"' }}>
                                Older <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{# A second page that needs Chart.js, not a second copy of it -- the
   Overview page already carries this same tag for the one chart it had
   before this one existed (G7.1, #332). #}
{% block scripts %}
    <script src="{{ asset(config('site.directory.js') ~ '/chart.umd.min.js') }}" defer></script>
{% endblock %}
