{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'content' %}

{% block title %}{{ article ? 'Edit article' : 'New article' }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="/admin/content">Help content</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ block('title') }}</li>
{% endblock %}

{% block tools %}<a class="btn btn-outline-secondary btn-sm" href="/admin/content">Back</a>{% endblock %}

{% block content %}
    {% if error %}
        {# `assertive`: the form is about to be corrected, and a message read
           out after the typing has started is read out too late. #}
        <p class="notice notice--bad" role="alert" aria-live="assertive">{{ error }}</p>
    {% endif %}

    {# Said on the form as well as in the list, because this is where somebody
       is about to take a row away from the files. #}
    {% if article and article.edited %}
        <p class="notice notice--owned">Edited here, so <code>articles:import</code> leaves it alone.</p>
    {% elseif article %}
        <p class="notice">The files still own this. Saving takes it over, and imports will stop rewriting it.</p>
    {% endif %}

    <form method="post" action="/admin/article{{ article and article.slug ? '/' ~ article.slug : '' }}">
        <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">

        <div class="card orchid-card mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="slug" class="form-label">Slug</label>
                        {# An existing article keeps its slug: renaming one orphans every
                           link to it, and nothing here would move them. #}
                        {% if article and article.slug %}
                            <input id="slug" name="slug" type="text" class="form-control" value="{{ article.slug }}" disabled>
                            <p class="field__hint">A slug cannot change &mdash; every link to this page is built from it.</p>
                        {% else %}
                            <input id="slug" name="slug" type="text" class="form-control" required
                                   pattern="[a-z0-9][a-z0-9-]*" maxlength="64"
                                   value="{{ article.slug|default('') }}"
                                   autocapitalize="off" spellcheck="false">
                            <p class="field__hint">Lower case letters, digits and hyphens. This becomes the address.</p>
                        {% endif %}
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="category" class="form-label">Category</label>
                        <select id="category" name="category" class="form-select" required>
                            {% for category in categories %}
                                <option value="{{ category.slug }}"{{ article and article.category == category.slug ? ' selected' : '' }}>
                                    {{ category.title }}{{ category.enabled ? '' : ' (hidden)' }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="title" class="form-label">Title</label>
                        <input id="title" name="title" type="text" class="form-control" required maxlength="255"
                               value="{{ article.title|default('') }}">
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="short" class="form-label">Short name</label>
                        <input id="short" name="short" type="text" class="form-control" maxlength="255"
                               value="{{ article.short|default('') }}">
                        <p class="field__hint">For lists where the full title is too long. Left empty, the title is used.</p>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="icon" class="form-label">Icon</label>
                        <input id="icon" name="icon" type="text" class="form-control" maxlength="64"
                               value="{{ article.icon|default('') }}" autocapitalize="off" spellcheck="false">
                        <p class="field__hint">A Font Awesome name, like <code>fa-suitcase</code>.</p>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="position" class="form-label">Position</label>
                        <input id="position" name="position" type="number" class="form-control" min="0" step="1"
                               value="{{ article.position|default(0) }}">
                        <p class="field__hint">Lowest first, within the category.</p>
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="summary" class="form-label">Summary</label>
                        <textarea id="summary" name="summary" class="form-control" rows="3" required>{{ article.summary|default('') }}</textarea>
                        <p class="field__hint">One or two sentences. Shown on the hub and in the page description.</p>
                    </div>

                    <div class="col-12 col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="enabled" name="enabled" value="1"
                                   {{ article is null or article.enabled ? 'checked' : '' }}>
                            <label class="form-check-label" for="enabled">Show this article on the site</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card orchid-card mb-3">
            <div class="card-body">
                <label for="body" class="form-label">Body</label>

                {# The preview is rendered by the server, by the same converter the
                   help page uses. A second implementation in the browser would
                   agree with this one right up until it did not. #}
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <textarea id="body" name="body" rows="22" class="form-control mono js-markdown-source"
                                  data-preview-url="/admin/preview" data-csrf="{{ csrf_token() }}"
                                  spellcheck="true">{{ article.body|default('') }}</textarea>
                    </div>

                    <div class="col-12 col-lg-6">
                        <p class="field__hint mb-1">Preview</p>
                        <div class="border rounded p-3 h-100 js-markdown-preview" aria-live="polite"></div>
                    </div>
                </div>

                <p class="field__hint">Markdown.</p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button type="submit" class="btn btn-primary">Save</button>
            {% if article and article.slug %}
                <a href="/help/{{ article.slug }}">View the page</a>
            {% endif %}
        </div>
    </form>
{% endblock %}
