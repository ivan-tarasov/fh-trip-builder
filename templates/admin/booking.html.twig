{% extends 'admin/layout.html.twig' %}
{% import 'partials/money.html.twig' as money %}

{% set admin_section = 'bookings' %}

{% block title %}{{ extra.reference ?: 'Booking ' ~ extra.id }}{% endblock %}

{% block tools %}
    <span class="text-body-secondary small mono">#{{ extra.id }}</span>

    {# Cancel and reinstate are each other's undo, which is what makes them safe
       to put on the page. Nothing here deletes: a cancelled booking is a row the
       traveller can still see, which is the whole reason `bookings.status`
       exists (G1.8, #233). #}
    <form method="post" action="/admin/bookings/{{ extra.id }}" class="d-inline">
        <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">
        <input type="hidden" name="action" value="{{ extra.is_cancelled ? 'reinstate' : 'cancel' }}">
        <button
            type="submit"
            class="btn btn-sm {{ extra.is_cancelled ? 'btn-outline-secondary' : 'btn-outline-danger' }}"
            data-confirm="{{ extra.is_cancelled
                ? 'Put this booking back to confirmed?'
                : 'Cancel this booking? The traveller will see it as cancelled.' }}"
        >{{ extra.is_cancelled ? 'Reinstate' : 'Cancel booking' }}</button>
    </form>

    <a class="btn btn-sm btn-outline-secondary" href="/admin/bookings">Back</a>
{% endblock %}

{# Drawn through `BookingPresenter`, the same shaper the traveller's own booking
   page uses -- so the itinerary, the money at its stored rate and the state read
   identically on both sides, which matters when the two are being compared down
   a phone (G1.8, #233). #}
{% block content %}
    {% if not booking %}
        <p class="notice notice--bad">
            This booking's flights will not build, so there is nothing to draw.
            The columns are still there; the legs it was folded from are gone.
            The log below and the buttons above still work on it, because this is
            exactly the row somebody rings up about.
        </p>
    {% else %}
        {# Two point-in-time facts, not trends -- the same stat-card shape G2.2
           uses without a fake comparison, because there is nothing stored to
           compare a single booking's reference or state against. #}
        <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6">
                <div class="card orchid-card stat-card h-100">
                    <div class="card-body">
                        <p class="stat-card__label">Reference</p>
                        <h3 class="stat-card__value mono">{{ booking.reference ?: 'none issued' }}</h3>
                        <p class="stat-card__note">made {{ booking.created|date('j M Y, H:i') }} &middot; {{ extra.made_ago }}</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6">
                <div class="card orchid-card stat-card{{ extra.is_cancelled ? ' stat-card--bad' : ' stat-card--good' }} h-100">
                    <div class="card-body">
                        <p class="stat-card__label">State</p>
                        <h3 class="stat-card__value">{{ booking.status_label }}</h3>
                        <p class="stat-card__note">
                            {% if booking.is_past %}already flown{% else %}{{ booking.departs_in }}{% endif %}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <p class="band">Who to contact</p>

        <div class="card orchid-card mb-3">
            <div class="table-responsive">
                <table class="table orchid-table align-middle mb-0">
                    <tbody>
                        <tr><td class="text-body-secondary">Email</td><td class="mono">{{ booking.contact_email ?: '—' }}</td></tr>
                        <tr><td class="text-body-secondary">Phone</td><td class="mono">{{ booking.contact_phone ?: '—' }}</td></tr>
                        {# Not identifying on its own, and it is how every other read
                           of this table finds a booking -- so an operator chasing a
                           duplicate can see they came from one person, not two. #}
                        <tr><td class="text-body-secondary">Session</td><td class="mono text-body-secondary">{{ extra.session ?: '—' }}</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <p class="band">Travelling</p>

        <div class="card orchid-card mb-3">
            <div class="table-responsive">
                <table class="table orchid-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Type</th>
                            <th scope="col">Born</th>
                            <th scope="col">Bookings</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for passenger in booking.passengers %}
                            <tr>
                                <td>{{ passenger.name }}</td>
                                <td class="text-body-secondary">{{ passenger.type }}</td>
                                <td class="mono text-body-secondary">{{ passenger.dob }}</td>
                                {# `elsewhere` is mapped from the same rows the
                                   presenter shaped, so position n here is position n
                                   there -- see AdminController::booking(). #}
                                <td>
                                    {% set count = elsewhere[loop.index0]|default(1) %}
                                    {% if count > 1 %}
                                        <a class="text-decoration-none" href="/admin/bookings?q={{ passenger.name|url_encode }}">{{ count }} bookings</a>
                                        {# Said plainly, because the number is a match
                                           on a name and a date of birth and not on a
                                           person. This site has no passenger table and
                                           no identity in it: a booking carries the
                                           words somebody typed into a form. #}
                                        <span class="text-body-secondary small">same name and date of birth</span>
                                    {% else %}
                                        <span class="text-body-secondary small">only this one</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-body-secondary">{{ booking.passenger_summary }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    {# The legs, one per row, rather than the card the search page draws.
       The *shaping* is still `BookingPresenter`'s, so nothing here can disagree
       with what the traveller is looking at -- but the card's drawing lives in
       `main.css`, which the panel does not load, and an operator on a phone
       wants the flight numbers the card keeps behind a click anyway. #}
    {% macro legs(direction, label) %}
        <div class="card orchid-card mb-3">
            <div class="card-header text-body-secondary small">
                {{ label }} &middot; {{ direction.duration }} in transit &middot; {{ direction.stops_label|lower }}
            </div>
            <div class="table-responsive">
                <table class="table orchid-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Flight</th>
                            <th scope="col">From</th>
                            <th scope="col">To</th>
                            <th scope="col">Cabin</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for leg in direction.segments %}
                            <tr>
                                <td>
                                    <span class="mono">{{ leg.flight_number }}</span>
                                    <span class="text-body-secondary small d-block">{{ leg.carrier_name }}</span>
                                </td>
                                <td>
                                    <span class="mono">{{ leg.depart_code }} {{ leg.depart_time }}</span>
                                    <span class="text-body-secondary small d-block">{{ leg.depart_date }}</span>
                                </td>
                                <td>
                                    <span class="mono">{{ leg.arrive_code }} {{ leg.arrive_time }}</span>
                                    <span class="text-body-secondary small d-block">{{ leg.arrive_date }}</span>
                                </td>
                                <td class="text-body-secondary">{{ leg.cabin ?: '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endmacro %}

    {% import _self as trip %}

        <p class="band">The trip</p>

        {{ trip.legs(booking.outbound, 'Outbound') }}
        {% if booking.return %}{{ trip.legs(booking.return, 'Return') }}{% endif %}

        <p class="band">What was paid</p>

        <div class="card orchid-card mb-3">
            <div class="table-responsive">
                <table class="table orchid-table align-middle mb-0">
                    <tbody>
                        <tr>
                            <td class="text-body-secondary">Total</td>
                            <td class="mono">{% if booking.price_total %}{{ money.whole(booking.price_total) }}{% else %}—{% endif %}</td>
                        </tr>
                        <tr><td class="text-body-secondary">Fare</td><td>{{ booking.fare_brand ?: '—' }}</td></tr>
                        <tr>
                            <td class="text-body-secondary">Card</td>
                            {# Every digit this site has ever held. No card number is
                               stored anywhere, which is what a receipt shows too. #}
                            <td class="mono">
                                {% if extra.card_last4 %}
                                    {{ booking.card_brand }} &middot;&middot;&middot;&middot; {{ extra.card_last4 }}
                                {% else %}
                                    &mdash;
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {# The log.

       Outside the `if` above on purpose: a booking whose flights will not build
       still has a history, and is the one an operator most wants it for.

       **Two things it is honest about.** It begins the day it was installed, so
       a booking older than that has no lines and says why rather than reading as
       one nothing ever happened to. And it records what happened *to* a booking,
       not every step the person took on the way to making it -- searches are
       stored as an aggregate keyed by a hash, with no session and no booking on
       them, so that history does not exist to show (G1.8, #233). #}
    <p class="band">Booking log</p>

    <div class="card orchid-card">
        <div class="table-responsive">
            <table class="table orchid-table align-middle mb-0">
                <tbody>
                    {% for line in log %}
                        <tr>
                            <td class="mono text-body-secondary" style="width: 1%; white-space: nowrap;">{{ line.at|date('j M Y, H:i') }}</td>
                            <td>
                                {{ line.event ? line.event.label() : line.raw }}
                                <span class="text-body-secondary small">
                                    by {{ line.actor ? line.actor.label() : 'somebody' }}{% if line.note %} &middot; {{ line.note }}{% endif %}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="mono text-body-secondary" style="width: 1%; white-space: nowrap;">{{ extra.made|date('j M Y, H:i') }}</td>
                            <td>
                                Booked
                                <span class="text-body-secondary small">
                                    from the booking's own row, which is the one thing
                                    about a booking this old that was written down
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if log is empty %}
        <p class="text-body-secondary small mt-2">
            {% if log_from %}
                Nothing has been recorded against this booking. The log has been
                running since {{ log_from|date('j M Y') }}, so anything that
                happened to this one before then was not written down.
            {% else %}
                Nothing has been recorded against any booking yet. The log starts
                with the next thing that happens.
            {% endif %}
        </p>
    {% endif %}
{% endblock %}
