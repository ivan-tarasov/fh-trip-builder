{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'bookings' %}

{% block title %}{{ extra.reference ?: 'Booking ' ~ extra.id }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="/admin/bookings">Bookings</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ block('title') }}</li>
{% endblock %}

{% block tools %}
    {# `#booking-tools` and `#booking-content` below are both `fetch()`
       targets: cancel/reinstate is the one action that changes something
       outside the content block (this button's own label, plus the "State"
       stat-card inside it), so its JSON answer carries a fragment for each
       (`admin.js`'s `ajaxBookingForms()`, G8.3, #338). #}
    <span id="booking-tools">
        {% include 'admin/partials/booking-tools.html.twig' %}
    </span>
{% endblock %}

{# Drawn through `BookingPresenter`, the same shaper the traveller's own booking
   page uses -- so the itinerary, the money at its stored rate and the state read
   identically on both sides, which matters when the two are being compared down
   a phone (G1.8, #233).

   The body itself lives in `admin/partials/booking-content.html.twig`, included
   rather than inlined so `AdminController` can render the exact same markup
   back to a `fetch()` after a POST -- see that file's own comment for why one
   fragment covers every action here rather than one per card. #}
{% block content %}
    {# `data-recent-*` here, not inside the swapped fragment below: read once
       by `recordRecentBooking()` (G4.3, #314) on a real navigation to this
       page, and left alone by `ajaxBookingForms()` replacing the fragment's
       `innerHTML` after a cancel/reinstate. #}
    <div id="booking-content"
         tabindex="-1"
         data-recent-booking-label="{{ extra.reference ?: 'Booking ' ~ extra.id }}"
         data-recent-booking-meta="{{ booking.passenger }}"
         data-recent-booking-url="/admin/bookings/{{ extra.id }}">
        {% include 'admin/partials/booking-content.html.twig' %}
    </div>
{% endblock %}
