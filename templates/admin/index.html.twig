{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'content' %}

{% block title %}Help content{% endblock %}

{# Everything that changes something is a form posting back here, so a refresh
   does not repeat the last move (A3.3, #101). #}
{% macro act(label, kind, slug, action, disabled) %}
    <form method="post" action="/admin" class="row__act">
        <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">
        <input type="hidden" name="kind" value="{{ kind }}">
        <input type="hidden" name="slug" value="{{ slug }}">
        <input type="hidden" name="action" value="{{ action }}">
        <button type="submit" class="button button--tiny"{{ disabled|default(false) ? ' disabled' : '' }}>{{ label }}</button>
    </form>
{% endmacro %}

{% import _self as do %}

{% block tools %}
    <a class="button" href="/admin/category">New category</a>
    <a class="button button--go" href="/admin/article">New article</a>
{% endblock %}

{% block content %}
    {% for category in categories %}
        <section class="group">
            <div class="row row--head">
                <a class="row__name" href="/admin/category/{{ category.slug }}">{{ category.title }}</a>
                <span class="row__slug">{{ category.slug }}</span>

                {% if not category.enabled %}<span class="flag">Hidden</span>{% endif %}

                {# Whose row this is. Edited here, the next `articles:import`
                   leaves it alone; untouched, the files still own it and an
                   import will rewrite it (A3.4, #102). #}
                {% if category.edited %}<span class="flag flag--owned">Edited here</span>{% endif %}

                <span class="row__acts">
                    {{ do.act('Up', 'category', category.slug, 'up', loop.first) }}
                    {{ do.act('Down', 'category', category.slug, 'down', loop.last) }}
                    {{ do.act(category.enabled ? 'Hide' : 'Show', 'category', category.slug, category.enabled ? 'hide' : 'show', false) }}
                </span>
            </div>

            {% for article in articles[category.slug]|default([]) %}
                <div class="row row--child">
                    <a class="row__name" href="/admin/article/{{ article.slug }}">{{ article.title }}</a>
                    <span class="row__slug">{{ article.slug }}</span>

                    {% if not article.enabled %}<span class="flag">Hidden</span>{% endif %}
                    {% if article.edited %}<span class="flag flag--owned">Edited here</span>{% endif %}

                    <span class="row__acts">
                        {{ do.act('Up', 'article', article.slug, 'up', loop.first) }}
                        {{ do.act('Down', 'article', article.slug, 'down', loop.last) }}
                        {{ do.act(article.enabled ? 'Hide' : 'Show', 'article', article.slug, article.enabled ? 'hide' : 'show', false) }}
                    </span>
                </div>
            {% else %}
                <p class="group__empty">No articles in this category.</p>
            {% endfor %}
        </section>
    {% endfor %}

    {# An article whose category names no row. ArticleRepository::all() says why
       one is kept rather than dropped; this is where it gets fixed. #}
    {% if orphans %}
        <section class="group">
            <div class="row row--head">
                <span class="row__name">Filed under a category that does not exist</span>
            </div>

            {% for article in orphans %}
                <div class="row row--child">
                    <a class="row__name" href="/admin/article/{{ article.slug }}">{{ article.title }}</a>
                    <span class="row__slug">{{ article.slug }} &mdash; {{ article.category }}</span>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    <p class="field__hint">This session ends after {{ idle_minutes }} minutes without a page here.</p>
{% endblock %}
