{# Every section A3 named is built: overview, content, bookings, fare alerts,
   settings (A3.7, #232). Nothing here is a dead link -- what does not exist
   is not clickable, which is why the rail used to carry a second, unclickable
   "Not built yet" list until this was the last thing on it. #}
<nav class="rail" aria-label="Sections">
    <a class="rail__mark" href="/" title="Back to the site">
        <span class="rail__mark-name">{{ config('app.name') }}</span>
        <span class="rail__mark-role">admin</span>
    </a>

    <ul class="rail__list">
        {% for item in [
            { 'href': '/admin', 'label': 'Overview', 'match': 'overview' },
            { 'href': '/admin/content', 'label': 'Help content', 'match': 'content' },
            { 'href': '/admin/bookings', 'label': 'Bookings', 'match': 'bookings' },
            { 'href': '/admin/subscribers', 'label': 'Fare alerts', 'match': 'subscribers' },
            { 'href': '/admin/settings', 'label': 'Settings', 'match': 'settings' }
        ] %}
            {% set current = admin_section|default('') == item.match %}
            <li>
                <a class="rail__item{{ current ? ' is-current' : '' }}" href="{{ item.href }}"
                   {{ current ? 'aria-current="page"' : '' }}>{{ item.label }}</a>
            </li>
        {% endfor %}
    </ul>

    <form method="post" action="/admin/logout" class="rail__out">
        <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">
        <button type="submit" class="button button--quiet button--block">Sign out</button>
    </form>
</nav>
