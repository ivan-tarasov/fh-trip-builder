{# Every section A3 named is built: overview, content, bookings, fare alerts,
   settings (A3.7, #232). Nothing here is a dead link -- what does not exist
   is not clickable, which is why the rail used to carry a second, unclickable
   "Not built yet" list until settings was the last thing on it.

   Fixed, permanent, and the same surface as the content beside it -- Orchid's
   own sidebar, not a separate dark band. `admin.js`'s `railToggle()` drives
   the mobile slide-in and the desktop collapse-to-icons; there is no
   Bootstrap component for either, since Orchid does not use one (A10.1,
   #287).

   The mark is the site's own -- `fa-plane-departure` on brand teal, the same
   icon `footer/bottom.html.twig` and the public header already carry -- drawn
   here with Bootstrap Icons' `bi-airplane-fill` instead of Font Awesome,
   which stays out of the panel (A3.5, #230). Fixed teal in both palettes,
   the same reason `main.css` gives for its own brand tile: a logo is not
   the thing that themes. #}
<div class="rail" id="adminRail">
    <div class="rail__top">
        <a class="rail__mark" href="/" title="Back to the site">
            <span class="rail__mark-logo" aria-hidden="true"><i class="bi bi-airplane-fill"></i></span>
            <span>
                <span class="rail__mark-name">{{ config('app.name') }}</span>
                <span class="rail__mark-role">Admin</span>
            </span>
        </a>
        <button type="button" class="btn btn-icon d-lg-none" data-rail-close aria-label="Close navigation">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>

    <div class="rail__body">
        {# One count each, read once -- every item below shares its own
           rather than asking again (G17, #375). #}
        {% set attention_count = admin_attention_count() %}
        {% set missing_ticket_count = bookings_missing_ticket_count() %}
        {% set schedule_issue_count = schedule_issue_count() %}

        {# Orchid's own tone palette, the same `-subtle`/solid convention
           `.status-chip` and the "What needs attention" notif cards
           already use -- a rail badge is one more place reading it, not
           a new one (G17, #375). Only `warn` has a tone in use so far
           (Overview and Bookings both, G18, #376); the rest exist so the
           next indicator is a line in an item's own `badge`, not a new
           mechanism. #}
        {% set badge_tones = {
            'warn': 'bg-warning-subtle text-warning',
            'bad': 'bg-danger-subtle text-danger',
            'good': 'bg-success-subtle text-success',
            'info': 'bg-primary-subtle text-primary'
        } %}

        {# Settings is the one item with children -- Orchid's own expandable-
           parent pattern for "Dashboard" (Bootstrap's stock Collapse, no
           bespoke JS), grafted onto the panel's real page-per-section
           structure rather than a static demo's `.html` files (G2.6, #299).
           A flat item still needs only `match`; a parent needs `group` (what
           `admin_section` is checked to *start with*, so it stays expanded
           and lit across all three of its children) and its own `children`
           list, each a flat item in its own right. An optional `badge`
           ({tone, value, label}) draws a count at the item's own right
           edge -- `label` is read to a screen reader instead of the bare
           number, since "8" alone says nothing (G17, #375). #}
        <ul class="rail__list">
            {% for item in [
                {
                    'href': '/admin', 'label': 'Overview', 'icon': 'speedometer2', 'match': 'overview',
                    'badge': attention_count > 0 ? {
                        'tone': 'warn', 'value': attention_count,
                        'label': attention_count == 1 ? 'thing needs attention' : 'things need attention'
                    } : null
                },
                {
                    'href': '/admin/schedule', 'label': 'Schedule', 'icon': 'clock-history', 'match': 'schedule',
                    'badge': schedule_issue_count > 0 ? {
                        'tone': 'warn', 'value': schedule_issue_count,
                        'label': schedule_issue_count == 1 ? 'job is late' : 'jobs are late'
                    } : null
                },
                { 'href': '/admin/searches', 'label': 'Searches', 'icon': 'search', 'match': 'searches' },
                {
                    'href': '/admin/bookings', 'label': 'Bookings', 'icon': 'briefcase', 'match': 'bookings',
                    'badge': missing_ticket_count > 0 ? {
                        'tone': 'warn', 'value': missing_ticket_count,
                        'label': missing_ticket_count == 1 ? 'booking needs a ticket' : 'bookings need a ticket'
                    } : null
                },
                { 'href': '/admin/subscribers', 'label': 'Fare alerts', 'icon': 'bell', 'match': 'subscribers' },
                { 'href': '/admin/content', 'label': 'Help content', 'icon': 'journal-text', 'match': 'content' },
                {
                    'href': '/admin/settings', 'label': 'Settings', 'icon': 'gear', 'group': 'settings',
                    'children': [
                        { 'href': '/admin/settings', 'label': 'Search rules', 'match': 'settings-search-rules' },
                        { 'href': '/admin/settings/site-identity', 'label': 'Site identity', 'match': 'settings-site-identity' },
                        { 'href': '/admin/settings/map', 'label': 'Map', 'match': 'settings-map' },
                        { 'href': '/admin/settings/diagnostics', 'label': 'Diagnostics', 'match': 'settings-diagnostics' }
                    ]
                }
            ] %}
                {% if item.children is defined %}
                    {% set expanded = admin_section|default('') starts with item.group %}
                    <li>
                        {# `data-bs-toggle` intercepts the click before `href` is
                           followed, so this link only ever toggles -- the href is
                           a no-JS fallback, not the normal way in. Reaching a
                           child means clicking a child. #}
                        <a class="rail__item{{ expanded ? ' is-current' : '' }}" href="{{ item.href }}"
                           data-bs-toggle="collapse" data-bs-target="#rail-{{ item.group }}-sub" role="button"
                           aria-expanded="{{ expanded ? 'true' : 'false' }}" aria-controls="rail-{{ item.group }}-sub">
                            <i class="bi bi-{{ item.icon }}" aria-hidden="true"></i>
                            <span>{{ item.label }}</span>
                            <i class="bi bi-chevron-down rail__chevron" aria-hidden="true"></i>
                        </a>
                        <ul class="collapse{{ expanded ? ' show' : '' }} rail__sub" id="rail-{{ item.group }}-sub">
                            {% for child in item.children %}
                                {% set current = admin_section|default('') == child.match %}
                                <li>
                                    <a class="rail__sublink{{ current ? ' is-current' : '' }}" href="{{ child.href }}"
                                       {{ current ? 'aria-current="page"' : '' }}>{{ child.label }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                {% else %}
                    {% set current = admin_section|default('') == item.match %}
                    <li>
                        <a class="rail__item{{ current ? ' is-current' : '' }}" href="{{ item.href }}"
                           {{ current ? 'aria-current="page"' : '' }}>
                            <i class="bi bi-{{ item.icon }}" aria-hidden="true"></i>
                            <span>{{ item.label }}</span>
                            {% if item.badge is defined and item.badge %}
                                <span class="badge {{ badge_tones[item.badge.tone] }} ms-auto" aria-label="{{ item.badge.value }} {{ item.badge.label }}">{{ item.badge.value }}</span>
                            {% endif %}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</div>

<div class="rail-backdrop" data-rail-close aria-hidden="true"></div>
