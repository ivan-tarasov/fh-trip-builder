{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'subscribers' %}

{% block title %}Fare alerts{% endblock %}

{% block tools %}
    <span class="stamp">{{ total }} on the list</span>
{% endblock %}

{# An address and a subscribe date is everything this row holds, so there is
   no page to open one for -- only the list and a way to take a row off it. #}
{% block content %}
    {% if subscribers is empty %}
        <p class="notice">Nobody has asked for fare alerts yet.</p>
    {% else %}
        <div class="group">
            <table class="sheet">
                <thead>
                    <tr>
                        <th scope="col">Address</th>
                        <th scope="col">Subscribed</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for subscriber in subscribers %}
                        <tr>
                            <td>{{ subscriber.email }}</td>
                            <td class="mono sheet__quiet">{{ subscriber.subscribed_at|date('j M Y') }}</td>
                            <td>
                                <form method="post" action="/admin/subscribers" class="list-row__act">
                                    <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">
                                    <input type="hidden" name="id" value="{{ subscriber.id }}">
                                    <button type="submit" class="button button--tiny">Remove</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if total > per_page %}
            <div class="pager">
                {% if page > 1 %}
                    <a class="button" href="/admin/subscribers?page={{ page - 1 }}">Newer</a>
                {% endif %}

                <span class="sheet__quiet">
                    {{ (page - 1) * per_page + 1 }}&ndash;{{ min(page * per_page, total) }} of {{ total }}
                </span>

                {% if page * per_page < total %}
                    <a class="button" href="/admin/subscribers?page={{ page + 1 }}">Older</a>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
