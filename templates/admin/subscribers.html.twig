{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'subscribers' %}

{% block title %}Fare alerts{% endblock %}

{% block tools %}
    <span class="text-body-secondary small">{{ total }} on the list</span>

    <a class="btn btn-sm btn-outline-secondary" href="/admin/subscribers/export">
        <i class="bi bi-download" aria-hidden="true"></i> Export CSV
    </a>
{% endblock %}

{# An address and a subscribe date is everything this row holds, so there is
   no page to open one for -- only the list and a way to take a row off it. #}
{% block content %}
    {% if subscribers is empty %}
        <p class="notice">Nobody has asked for fare alerts yet.</p>
    {% else %}
        <div class="card orchid-card">
            <div class="table-responsive">
                <table class="table orchid-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Address</th>
                            <th scope="col">Subscribed</th>
                            <th scope="col" class="text-end">&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for subscriber in subscribers %}
                            <tr>
                                <td>{{ subscriber.email }}</td>
                                <td class="mono text-body-secondary">{{ subscriber.subscribed_at|date('j M Y') }}</td>
                                <td class="text-end row-actions" style="width: 1%;">
                                    <form method="post" action="/admin/subscribers">
                                        <input type="hidden" name="{{ csrf_field() }}" value="{{ csrf_token() }}">
                                        <input type="hidden" name="id" value="{{ subscriber.id }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if total > per_page %}
            <div class="d-flex align-items-center justify-content-between mt-3">
                <span class="text-body-secondary small">
                    {{ (page - 1) * per_page + 1 }}&ndash;{{ min(page * per_page, total) }} of {{ total }}
                </span>

                <nav aria-label="Fare alert pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item{{ page > 1 ? '' : ' disabled' }}">
                            <a class="page-link" href="/admin/subscribers?page={{ page - 1 }}"{{ page > 1 ? '' : ' tabindex="-1" aria-disabled="true"' }}>
                                <i class="bi bi-chevron-left" aria-hidden="true"></i> Newer
                            </a>
                        </li>
                        <li class="page-item{{ page * per_page < total ? '' : ' disabled' }}">
                            <a class="page-link" href="/admin/subscribers?page={{ page + 1 }}"{{ page * per_page < total ? '' : ' tabindex="-1" aria-disabled="true"' }}>
                                Older <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
