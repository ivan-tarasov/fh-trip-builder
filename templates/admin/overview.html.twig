{% extends 'admin/layout.html.twig' %}

{% set admin_section = 'overview' %}

{% block title %}Overview{% endblock %}

{# When every figure was read. Nothing on this page is cached -- a dashboard
   reporting a cached number is reporting on the cache -- so saying when it was
   read is what lets somebody trust a green tile (A3.6, #231). #}
{% block tools %}<span class="stamp">read {{ read_at }}</span>{% endblock %}

{% block content %}
    <p class="band">Is it running</p>

    {# States, not numbers: "is it running" is not a quantity. Every tile prints
       its state in words as well as wearing a tone, so the colour is emphasis
       rather than information. #}
    <div class="tiles">
        {% for state in states %}
            <div class="tile tile--{{ state.tone.value }}">
                <p class="tile__label">{{ state.label }}</p>
                <p class="tile__value">{{ state.value }}</p>
                <p class="tile__note">{{ state.note }}</p>
            </div>
        {% endfor %}
    </div>

    <p class="band">How much there is</p>

    <div class="tiles">
        {% for count in counts %}
            <div class="tile tile--plain">
                <p class="tile__label">{{ count.label }}</p>
                {# `none yet` and not `0`. They read the same to a machine and
                   differently to a person: one is a measurement, the other is a
                   site nobody has used. #}
                <p class="tile__value{{ count.value is null ? ' tile__value--none' : ' mono' }}">
                    {{ count.value ?? 'none yet' }}
                </p>
                <p class="tile__note">{{ count.note }}</p>
            </div>
        {% endfor %}
    </div>

    <p class="band">What ran, and when</p>

    {# The dense surface. The strip above summarises this; this is what an
       operator actually reads when the summary is not green. #}
    <div class="group">
        <table class="sheet">
            <thead>
                <tr>
                    <th scope="col">Command</th>
                    <th scope="col">Due</th>
                    <th scope="col">Last success</th>
                    <th scope="col">Exit</th>
                </tr>
            </thead>
            <tbody>
                {% for task in schedule %}
                    <tr>
                        <td class="mono">{{ task.command }}</td>
                        <td class="mono sheet__quiet">{{ task.due }}</td>
                        <td class="mono sheet__quiet">{{ task.age }}</td>
                        <td>
                            {% if task.exit is null %}
                                <span class="pill">never</span>
                            {% elseif task.stale %}
                                <span class="pill pill--bad">late</span>
                            {% elseif task.exit == 0 %}
                                <span class="pill pill--good">ok</span>
                            {% else %}
                                <span class="pill pill--bad">exit {{ task.exit }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="sheet__quiet">The schedule could not be read.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="pair">
        <div class="tile tile--plain">
            <p class="tile__label">Content</p>
            {# `article(s)` is the CLI's idiom and it does not belong on a
               page somebody reads. #}
            <p class="tile__line">
                {{ content.articles }} {{ content.articles == 1 ? 'article' : 'articles' }}
                in {{ content.categories }} {{ content.categories == 1 ? 'category' : 'categories' }}
            </p>
            <p class="tile__note">
                {{ content.hidden }} hidden &middot;
                {# A3.4's column (#102): how much of the help text the next
                   `articles:import` will leave alone. #}
                {{ content.owned }} edited here
            </p>
        </div>

        <div class="tile tile--plain">
            <p class="tile__label">Most searched</p>
            {% for search in searches %}
                <p class="tile__line mono">{{ search.from }} &rarr; {{ search.to }}
                    <span class="sheet__quiet">{{ search.count }}</span></p>
            {% else %}
                <p class="tile__note">Nobody has searched yet.</p>
            {% endfor %}
        </div>
    </div>

    {# Said here rather than drawn: `search` is an aggregate -- one row per
       distinct search with a count -- so it cannot answer "searches per day",
       and a line that looked like it could would be inventing one. #}
    <p class="field__hint">
        No charts yet: nothing on this page has a per-day history to draw.
        This session ends after {{ idle_minutes|default(60) }} minutes without a page here.
    </p>
{% endblock %}
