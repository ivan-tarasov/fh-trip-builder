# Internal flights API: base URL, the token this app sends as a client,
# and the comma-separated list of tokens the API side accepts.
API_URL=https://example.com/api
API_TOKEN=your-api-client-token
API_ACCEPTED_TOKENS=first-accepted-token,second-accepted-token
