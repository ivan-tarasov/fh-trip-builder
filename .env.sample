APP_NAME=TripBuilder
APP_ENV=common

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=database_user
DB_PASSWORD=database_password

AWS_REGION=ca-central-1
AWS_BUCKET=static-tripbuilder.tarasov.ca
AWS_CLOUDFRONT=d3i7jsp0grgmab.cloudfront.net

# API auth: comma-separated Bearer tokens the app's /api endpoints accept from
# external clients. The public /api/airports/autofill endpoint is exempt, and
# the browser autofill calls it same-origin (no base URL / token needed).
API_ACCEPTED_TOKENS=first-accepted-token,second-accepted-token
