APP_ENV=common

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=database_user
DB_PASSWORD=database_password

# A write credential, needed only by `airside:import` when it uploads. The
# pages read through CloudFront and need none of this.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_REGION=us-east-2
AWS_BUCKET=trip-builder-270660778441-us-east-2-an
AWS_CLOUDFRONT=d1kf00o84yn9o.cloudfront.net

# Static maps. A Mapbox public token ("pk...."), which is what the city,
# country, airport, airline and route pages draw their map picture with. It is
# public by design -- it ends up in an <img> URL -- but it is still per
# environment and still rate-limited, so it lives here and not in config.
#
# Left empty, the pages render without a map rather than with a broken one.
MAPBOX_TOKEN=

# API auth: comma-separated Bearer tokens the app's /api endpoints accept from
# external clients. The public /api/airports/autofill endpoint is exempt, and
# the browser autofill calls it same-origin (no base URL / token needed).
API_ACCEPTED_TOKENS=first-accepted-token,second-accepted-token

# The admin panel's single password, as a hash. Generate one with
# `php noah admin:password` and paste the line it prints. Left empty, the panel
# refuses every sign-in -- which is the right default for a server nobody has
# decided to put a password on yet.
ADMIN_PASSWORD_HASH=

# Mailtrap's transactional Send API, for route price alerts (C6, #155). The
# from address must be on a domain verified in Mailtrap or every send is
# refused. Left empty, `alerts:check` fails loudly rather than pretending to
# have sent anything.
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=

# A Sandbox's numeric id (from its URL, e.g. mailtrap.io/sandboxes/2564102),
# for the "Send test email" button on the admin panel's Diagnostics page
# only. `alerts:check` never reads this and always sends for real, whatever
# this is set to. Leave empty on a production server -- the test button
# then sends for real too, which is a reasonable thing to want to confirm
# there, just not something to reach for casually.
MAILTRAP_SANDBOX_INBOX_ID=
