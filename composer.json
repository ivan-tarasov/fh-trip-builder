{
    "name": "tarasov/trip-builder",
    "description": "Web Developer PHP assessment for a FlightHub.",
    "license": "proprietary",
    "type": "project",
    "autoload": {
      "psr-4": {"TripBuilder\\": "src/"}
    },
    "require": {
        "thingengineer/mysqli-database-class": "dev-master#5159467ae081adbe96586e45e65a58c0fe7a32ce",
        "vlucas/phpdotenv": "^5.5",
        "guzzlehttp/guzzle": "^7.7",
        "symfony/console": "^6.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "rector/rector": "^2.0",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor src tests index.php noah",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "csfix": "php-cs-fixer fix",
        "cscheck": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process --dry-run"
    }
}
